<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.roller</groupId>
        <artifactId>roller-project</artifactId>
        <version>6.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <name>Roller webapp</name>
    <artifactId>roller-webapp</artifactId>
    <packaging>war</packaging>

    <properties>
        <asm.version>9.10.1</asm.version>
        <bouncycastle.version>1.85</bouncycastle.version>
        <commons-validator.version>1.11.0</commons-validator.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-text.version>1.15.0</commons-text.version>
        <eclipse-link.version>5.0.1</eclipse-link.version>
        <jdom2.version>2.0.6.1</jdom2.version>
        <lucene.version>10.5.0</lucene.version>
        <maven-war.version>3.5.1</maven-war.version>
        <pitest.version>1.25.8</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <!-- Overridden on the command line to scope a mutation run. -->
        <pit.targets>org.apache.roller.weblogger.util.*</pit.targets>
        <pit.tests>org.apache.roller.weblogger.util.*</pit.tests>
        <spring-boot.version>4.1.0</spring-boot.version>
        <velocity.version>2.4.1</velocity.version>

        <!-- jspc-maven-plugin (process-classes JSP validation, below) ships
             Jasper 10.1.x by default. Pin its bundled Tomcat artifacts to the
             same Tomcat/Jasper version the app actually runs on -
             tomcat-embed-jasper's version as resolved from the Spring Boot BOM
             (see `mvn dependency:tree -Dincludes=org.apache.tomcat.embed:tomcat-embed-jasper`)
             - so build-time validation exercises the same JSP compiler as
             production. -->
        <jspc-plugin.version>5.0.0</jspc-plugin.version>
        <!-- NOT bumped to 11.0.24 on purpose: this must equal the Tomcat version
         the Spring Boot BOM resolves for tomcat-embed-jasper (verified 11.0.22),
         or build-time JSP validation stops exercising the compiler production
         uses, which is the entire point of pinning it. -->
    <jspc-plugin.tomcat.version>11.0.22</jspc-plugin.tomcat.version>
    </properties>

    <!-- Spring Boot 4's BOM manages JUnit 6 (junit-jupiter 6.0.3,
         junit-platform-launcher, ...), mockito 5.23.0, and testcontainers
         2.0.5 as a known-good set. The root pom no longer re-pins
         junit-jupiter-engine or imports junit-bom, so this import is the
         sole source of truth for JUnit/mockito versions; the root pom
         still imports testcontainers-bom itself (its version already
         matches Boot's managed testcontainers, so there's no conflict). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Spring Boot -->

        <!-- Logging is excluded from every starter below: Roller pins its own
             log4j2/slf4j stack (see the slf4j/log4j2 deps further down) and
             spring-boot-starter-log4j2 supplies the Boot-side log4j2 wiring
             without dragging in Logback. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Provided, not compile: the executable WAR still needs Tomcat and
             Jasper at container-launch time (spring-boot-maven-plugin packages
             `provided`-scope deps into WEB-INF/lib-provided and puts them on the
             launcher classpath), but they must not double up with an external
             Tomcat's own copies when the WAR is deployed unpacked instead. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
            <exclusions>
                <!-- Pulls spring-boot-starter -> spring-boot-starter-logging
                     (Logback + log4j-to-slf4j), which collides with the
                     log4j-slf4j2-impl pin below: "log4j-slf4j2-impl cannot be
                     present with log4j-to-slf4j". -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Replaces the explicit spring-security-* version pins below with BOM
             governance; spring-security-taglibs isn't pulled in by this starter
             and stays declared explicitly further down. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jakarta EE deps -->

        <!-- jakarta.servlet-api and jakarta.servlet.jsp-api are no longer declared
             explicitly: spring-boot-starter-tomcat / tomcat-embed-jasper (both
             above, scope provided) supply the 6.1 / 4.0 Jakarta EE 11 APIs that
             Boot 4 / Tomcat 11 implement. -->

        <!-- The JSTL API. Tomcat ships no JSTL at all, and the Glassfish artifact
             below is only the implementation, so without this the WAR deploys to
             Tomcat and every JSP dies with
             NoClassDefFoundError: jakarta/servlet/jsp/jstl/fmt/LocalizationContext.
             The Jetty dev server masked this because jetty-maven-plugin's
             glassfish-jstl supplies the API on its own classpath. -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <exclusions>
                <!-- Drags slf4j-api 1.7.36, which silently downgraded the 2.0.x
                     API that jcl-over-slf4j and jul-to-slf4j are built against.
                     slf4j-api is declared explicitly below instead. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jakarta Mail API 2.1+ uses jakarta.mail.MailLogger (not com.sun.mail).
             Must be compile scope and listed BEFORE angus-mail to override
             the older 2.0.1 version that angus-mail pulls transitively.
             Version comes from Spring Boot's BOM (jakarta-mail.version). -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
        </dependency>

        <!-- Angus Mail provides the Jakarta Mail implementation. -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.activation</groupId>
            <artifactId>jakarta.activation-api</artifactId>
        </dependency>

        <!-- jakarta.xml.bind-api removed: zero source references
             (org.apache.roller.**), and `dependency:tree` shows it was only
             present because of this now-deleted declaration - nothing else
             in the graph pulls it transitively. Confirmed at runtime too: a
             `java -jar` boot smoke against a migrated ./roller db dev
             database - full RollerLifecycle/EclipseLink/Lucene bootstrap,
             front page (302) and login page (200) both serve - with zero
             JAXB-related exceptions in roller.log. -->

        <!-- Eclipselink is the only JPA implementation Roller supports.
             Logging, other special configuration during JUnit tests can be
             placed in the src/test/resources/roller-custom.properties file.
         -->
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>org.eclipse.persistence.jpa</artifactId>
            <version>${eclipse-link.version}</version>
        </dependency>

        <!-- small dependency containing slf4j bridge for eclipselink -->
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>org.eclipse.persistence.extension</artifactId>
            <version>${eclipse-link.version}</version>
        </dependency>

        <!-- PostgreSQL is the only database Roller supports as of 6.2.0.
             Version comes from Spring Boot's BOM; it-selenium runs its IT
             Postgres as a Docker image (${it.postgres.image}), not this JDBC
             driver, so nothing else needs a shared property here. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Apache deps include Velocity and Lucene -->

        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>${velocity.version}</version>
        </dependency>

        <!-- explicitly adding newest asm lib to improve compatibility with latest JDKs -->

        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>

        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>${asm.version}</version>
        </dependency>

        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>${asm.version}</version>
        </dependency>


        <!-- note: update head.jsp on webjar version change -->
        <!-- webjars-servlet-2.x removed (javax-only); webjars served by Spring MVC resource handler -->

        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
            <version>5.3.8</version>
        </dependency>

        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bootstrap-icons</artifactId>
            <version>1.13.1</version>
        </dependency>

        <!-- EasyMDE's toolbar buttons (bold/italic/heading/etc, in the entry
             and page editors) carry "fa fa-*" icon-font classes: its own
             CSS ships no glyphs, just the class names, and EasyMDE is
             configured with autoDownloadFontAwesome:false (see EntryEditor.jsp
             /PageEdit.jsp) so it never injects a CDN link for the font.
             Without a locally-hosted Font Awesome the classes have no font
             backing them and every toolbar icon renders as an empty box.
             4.7.0 (not 5/6) because the class names EasyMDE emits,
             fa-check-square-o and fa-arrows-alt, are Font Awesome 4 names. -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>font-awesome</artifactId>
            <version>4.7.0</version>
        </dependency>

        <!-- IBM Plex Sans/Mono ("Quiet Instrument" design tokens, see
             docs/design/design-system.md), self-hosted so the admin UI never
             depends on a Google Fonts fetch. Published under the npm scope
             @ibm/plex-sans / @ibm/plex-mono; webjars.org mangles a scoped
             package name into a double-underscore artifact id
             (ibm__plex-sans, not ibm-plex-sans, which does not exist as a
             coordinate). 0.0.3-alpha.0 is the only version either package
             has ever published to Maven Central despite the "alpha" tag;
             the glyphs themselves are IBM's released OFL-1.1 Plex fonts
             (license text ships inside the jar at
             META-INF/resources/webjars/ibm__plex-*/*/LICENSE.txt), not a
             prerelease build of the typeface. roller-tokens.css declares
             @font-face for exactly the weights the spec uses: Sans 450
             (body) and 600 (headings/labels), Mono 400 (data). -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>ibm__plex-sans</artifactId>
            <version>0.0.3-alpha.0</version>
        </dependency>

        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>ibm__plex-mono</artifactId>
            <version>0.0.3-alpha.0</version>
        </dependency>

        <!-- IBM Plex Serif, sibling of the two Plex webjars above: the
             journal theme's serif titles/prose (docs/design/journal/,
             Theme Wave Stage 2). Same coordinate shape and same
             0.0.3-alpha.0 version (verified on Maven Central; it is, as with
             Sans/Mono, the only version @ibm/plex-serif has ever published).
             journal-custom.css declares @font-face for weights 400 (body)
             and 600 (titles/headings), the way roller-tokens.css does for
             Sans/Mono. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>ibm__plex-serif</artifactId>
            <version>0.0.3-alpha.0</version>
        </dependency>

        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>clipboard.js</artifactId>
            <version>2.0.11</version>
        </dependency>

        <!-- Cropper.js v2 (custom-element API), admin media editor only -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>cropperjs</artifactId>
            <version>2.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>jquery</artifactId>
            <!-- Held at 3.x deliberately. jQuery 4 removes .bind()/.unbind(),
                 which MediaFileSidebar.jsp still uses, and $.isFunction, which
                 the gaurav theme's vendored bootstrap.js calls; jquery-ui
                 1.14.x and jquery-validation are also not certified against
                 it. Moving to 4 is a piece of work, not a version bump. -->
            <version>3.7.1</version>
        </dependency>

        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>jquery-ui</artifactId>
            <version>1.14.2</version>
        </dependency>

        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>jquery-validation</artifactId>
            <version>1.21.0</version>
        </dependency>

        <!-- Public-surface lightbox, referenced from #showGalleryAssets in
             WEB-INF/velocity/weblog.vm (three /webjars/photoswipe/ URLs).
             Update those on a version bump; WebjarReferenceTest fails on
             any drift between this version and the template references. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>photoswipe</artifactId>
            <version>5.4.3</version>
        </dependency>

        <!-- Public-surface map for the [map] shortcode, referenced from
             #showMapAssets in WEB-INF/velocity/weblog.vm (leaflet.css,
             leaflet.js and the three marker PNGs, all under the npm
             webjar's dist/ segment; the abandoned org.webjars:leaflet
             artifact has no dist/). BSD-2-Clause, no transitive deps.
             Update those URLs on a version bump; WebjarReferenceTest fails
             on any drift between this version and the template references.
             Stay on 1.x: 2.0.0-alpha drops the UMD build and removes every
             lowercase factory function (L.map becomes new L.Map), which
             would break the macro's script wholesale. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>leaflet</artifactId>
            <version>1.9.4</version>
        </dependency>

        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <scope>compile</scope>
            <version>${lucene.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-backward-codecs</artifactId>
            <scope>compile</scope>
            <version>${lucene.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
            <scope>compile</scope>
            <version>${lucene.version}</version>
        </dependency>

        <!-- slf4j implementing the apache commons-logging interfaces -->
        <!-- note: commons-logging needs to be excluded in all dependencies transitive depending on it.
        See 2006 RFE https://issues.apache.org/jira/browse/MNG-1977 for maven's missing feature of global exclusions -->
        <!-- Version comes from Spring Boot's BOM (slf4j.version, 2.0.18+):
             still declared explicitly (not left to whatever a transitive
             caller would pick) because a 1.7.x slf4j-api is binary-
             incompatible with the 2.0.x ServiceLoader-based provider lookup
             used below. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
        </dependency>

        <!-- slf4j implementing java.util.logging interfaces (needed for WebJars, ..) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
        </dependency>

        <!-- the actual logging impl below slf4j: log4j2.
             log4j-slf4j2-impl, not log4j-slf4j-impl: the latter binds the
             SLF4J 1.7 StaticLoggerBinder API and would pull slf4j-api back
             down to 1.7.x. Version comes from Spring Boot's BOM
             (log4j2.version, via its log4j-bom import). -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
            <version>${commons-validator.version}</version>
            <type>jar</type>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>commons-beanutils</groupId>
            <artifactId>commons-beanutils</artifactId>
            <version>${commons-beanutils.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Version comes from Spring Boot's BOM (commons-codec.version). -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>${commons-text.version}</version>
         </dependency>

        <!-- Version comes from Spring Boot's BOM (commons-lang3.version). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Image resizing for responsive media renditions (Stage 2 Wave 1).
             Not Boot-BOM-managed, so the version is pinned explicitly here.
             Delegates encoding to ImageIO; WebP output is produced separately
             by shelling out to the cwebp CLI when present (no maintained JVM
             WebP encoder exists). -->
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>0.4.21</version>
        </dependency>

        <!-- EXIF/GPS/lens metadata extraction from uploaded images (Stage 2 Wave 1).
             Not Boot-BOM-managed, so the version is pinned explicitly here. -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.21.0</version>
        </dependency>

        <!-- The Markdown editor. Every entry is Markdown, so this is the
             editor, not one of two. Its dist bundle carries its own CodeMirror,
             so there is no second webjar to keep in step. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>easymde</artifactId>
            <version>2.21.0</version>
        </dependency>

        <!-- The HTML sanitizer: parses and re-serializes rendered entry HTML
             against an allow-list policy (Stage 2 Wave 4). Replaced a vendored
             regex sanitizer; Apache-2.0, same family Wikantik uses. -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>20260313.1</version>
        </dependency>

        <!-- Markdown: every entry is Markdown (Stage 2 Wave 4). Not managed by
             the Boot BOM, so the version is pinned here; the three extensions
             are separate artifacts on purpose. -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.29.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>0.29.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
            <version>0.29.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-autolink</artifactId>
            <version>0.29.0</version>
        </dependency>

        <!-- Spring deps. Versions are no longer pinned here: spring-boot-dependencies
             (imported above) governs every org.springframework* / org.springframework.security*
             artifact. spring-boot-starter-web/-security already pull spring-web,
             spring-context, spring-webmvc, and spring-security-config transitively;
             they stay declared explicitly here because application code compiles
             against them directly. -->

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <exclusions>
                <!-- in jcl-over-slf4j  -->
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-jcl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>


        <!-- spring-security-openid removed in Spring Security 6.0;
             OpenID Connect (OIDC) via OAuth2 client is the replacement -->

        <!-- Not pulled in by spring-boot-starter-security; stays explicit. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-taglibs</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-acl</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-jdbc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Used directly by ThemeMetadataParser, RuntimeConfigDefsParser, and
             MenuHelper to parse theme.xml / runtimeConfigDefs.xml / the admin
             menu config. Previously rode in transitively via com.rometools:rome
             (now removed); declared explicitly since nothing to do with feeds
             actually depends on it. -->
        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom2</artifactId>
            <version>${jdom2.version}</version>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Test deps -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- RollerTestBootstrap is a LauncherSessionListener, so the launcher
             API must be on the test classpath at compile time. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Version comes from Spring Boot's BOM (mockito.version, via its
             mockito-bom import). -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SecurityConfigTest (Stage 1B Task 4) still does NOT use
             @SpringBootTest/@AutoConfigureMockMvc, but the reason is now
             historical: this project ran junit-bom 5.14.3, and spring-test's
             SpringExtension compiled against a junit-jupiter-api 6.0+-only
             method (ExtensionContext.Store.computeIfAbsent(Object,Function,Class)),
             throwing NoSuchMethodError for every @ExtendWith(SpringExtension.class)
             test. Stage 1D Task 6 moved the project onto JUnit 6
             (junit-jupiter 6.0.3 via Spring Boot's BOM), so that
             NoSuchMethodError no longer reproduces. spring-boot-test/
             -test-autoconfigure/-webmvc-test are still not added here and
             SecurityConfigTest is not rewritten onto @SpringBootTest: that
             conversion is an optional follow-up (see the Stage 1D plan),
             not required by the JUnit 6 bump itself. -->

        <!-- SecurityMockMvcRequestPostProcessors.user(...) and
             SecurityMockMvcConfigurers.springSecurity() (both needed by
             SecurityConfigTest): pure MockMvc configurer/post-processor
             utilities with no SpringExtension/JUnit-version coupling, so this
             half of spring-security-test works regardless. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @ParameterizedTest/@ValueSource (SecurityConfigTest's authorization
             matrix): not pulled in transitively by junit-jupiter-engine. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-junit</artifactId>
            <version>5.6.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <finalName>roller</finalName>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war.version}</version>
                <configuration>
                    <attachClasses>true</attachClasses>
                    <!-- web.xml is deleted (Stage 1B Task 3): all its servlet/
                         filter/error-page/welcome-file/jsp-config content is now
                         Java config under org.apache.roller.weblogger.boot, and
                         Boot's embedded container never read web.xml anyway.
                         Without this flag maven-war-plugin fails the build
                         outright when web.xml is missing. -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Rewrites the primary WAR into an executable one (Boot loader
                 classes + WEB-INF/lib-provided) after maven-war-plugin builds it.
                 `java -jar app/target/roller.war` runs it standalone; the same
                 WAR can still be deployed unpacked to an external container. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- spring-boot-dependencies is imported as a dependency BOM only
                     (the parent stays roller-project, not spring-boot-starter-parent),
                     so it does not manage plugin versions; pin explicitly. -->
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>

                <executions>

                    <execution>
                        <id>copy-main-resources</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${basedir}/target/classes</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!-- The canonical schema migrations live in bin/db/migrations so that
                         bin/db/migrate.sh can read them directly. Copy them onto the
                         classpath as /dbmigrations so they also ship inside the WAR and
                         can be applied by DatabaseInstaller (the web install wizard).
                         One source of truth, two entry points. -->
                    <execution>
                        <id>copy-db-migrations</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${basedir}/target/classes/dbmigrations</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}/../bin/db/migrations</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>V*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!-- <execution>
                        <id>copy-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/roller/WEB-INF/classes/dbscripts</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>target/dbscripts</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>**/*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution> -->

                </executions>

                <configuration>
                    <includeEmptyDirs>true</includeEmptyDirs>
                </configuration>

            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <systemProperties>
                        <property>
                            <name>project.build.directory</name>
                            <value>${basedir}/target</value>
                        </property>
                    </systemProperties>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>

            <!-- Compile every JSP at build time. JSP syntax and taglib errors
                 otherwise only surface when a page is first requested, and pages
                 behind authentication can sit broken indefinitely. -->
            <plugin>
                <groupId>io.leonard.maven.plugins</groupId>
                <artifactId>jspc-maven-plugin</artifactId>
                <version>${jspc-plugin.version}</version>
                <executions>
                    <execution>
                        <id>jspc-validate</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <!-- Validation only: the WAR ships .jsp sources and lets
                                 the container compile them, so this output is
                                 discarded and never merged into web.xml. -->
                            <generatedClasses>${project.build.directory}/jspc-validation</generatedClasses>
                            <webXmlFragment>${project.build.directory}/jspc-validation/web-fragment.xml</webXmlFragment>
                            <includes>**/*.jsp</includes>
                            <mergeFragment>false</mergeFragment>
                            <stopAtFirstError>true</stopAtFirstError>
                        </configuration>
                    </execution>
                </executions>
                <!-- The plugin bundles Jasper 10.1.x by default. Only tomcat-jasper
                     is a direct dependency of the plugin; the other eight Tomcat
                     artifacts below are pulled in transitively from it, so
                     overriding tomcat-jasper alone is enough to bring the whole
                     set to 11.0.22 today. They're pinned here anyway, defensively,
                     so a future plugin release restructuring its dependency graph
                     (e.g. flattening a transitive dep to direct, or dropping the
                     transitive relationship) cannot silently mix Jasper versions
                     on the validation classpath. -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-jasper</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-jasper-el</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-servlet-api</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-jsp-api</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-el-api</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-api</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-util</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-util-scan</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.tomcat</groupId>
                        <artifactId>tomcat-juli</artifactId>
                        <version>${jspc-plugin.tomcat.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Mutation testing. JaCoCo says which lines ran; PIT says whether a
                 test would have noticed them changing. Not bound to a lifecycle
                 phase because a full run over ~19k lines is slow; scope it to the
                 code you are working on:

                   mvn -pl app test-compile org.pitest:pitest-maven:mutationCoverage \
                       -Dpit.targets='org.apache.roller.weblogger.util.*' \
                       -Dpit.tests='org.apache.roller.weblogger.util.*'

                 Report: app/target/pit-reports/index.html -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <configuration>
                    <targetClasses>
                        <param>${pit.targets}</param>
                    </targetClasses>
                    <targetTests>
                        <param>${pit.tests}</param>
                    </targetTests>
                    <outputFormats>
                        <outputFormat>HTML</outputFormat>
                        <outputFormat>XML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <!-- Tests that need Docker/Testcontainers are excluded: PIT reruns
                         the suite once per mutant and container startup would dominate
                         the runtime. Mutation testing targets pure logic anyway. -->
                    <excludedTestClasses>
                        <param>org.apache.roller.weblogger.business.*</param>
                        <param>org.apache.roller.weblogger.ui.rendering.model.SearchResults*</param>
                    </excludedTestClasses>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doUpdate>false</doUpdate>
                    <revisionOnScmFailure>UNKNOWN</revisionOnScmFailure>
                </configuration>
            </plugin>

        </plugins>

        <testResources>
            <testResource>
                <directory>${project.basedir}/../app/src/main/webapp/</directory>
                <filtering>false</filtering>
                <includes>
                    <include>themes/**</include>
                </includes>
            </testResource>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/**</include>
                </includes>
            </testResource>
        </testResources>

        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>org/**</include>
                </includes>
                <excludes>
                    <exclude>**/sql/**</exclude>
                </excludes>
            </resource>
            <resource>
                <!-- ensure version gets substitution -->
                <directory>${project.basedir}/src/main/resources-filtered</directory>
                <filtering>true</filtering>
                <includes>
                    <include>roller-version.properties</include>
                </includes>
            </resource>
        </resources>

    </build>

</project>
