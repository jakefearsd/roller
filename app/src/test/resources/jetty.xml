<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "http://www.eclipse.org/jetty/configure_9_3.dtd">

<!-- Dev-only values, used when running Roller with mvn jetty:run.

     This expects the PostgreSQL from docker-compose.yml to be running:
         docker compose up -d postgres
     or just use ./roller dev, which starts it and applies migrations first.

     Before 6.2.0 this block started an in-memory Derby via DerbyLifeCycle, so
     dev data was wiped on every restart. It now points at a real PostgreSQL
     with a named volume, so dev content survives restarts. -->

<Configure id="Server" class="org.eclipse.jetty.server.Server">

    <New id="ds" class="org.eclipse.jetty.plus.jndi.Resource">
        <Arg> <Ref id="wac_ds"/> </Arg>
        <Arg>jdbc/rollerdb</Arg>
        <Arg>
            <New class="org.apache.commons.dbcp2.BasicDataSource">
                <Set name="driverClassName">org.postgresql.Driver</Set>
                <Set name="url">jdbc:postgresql://localhost:5432/rollerdb</Set>
                <Set name="username">roller</Set>
                <Set name="password">roller</Set>
            </New>
        </Arg>
    </New>

    <!-- Mail: no JNDI binding needed. Dev mode uses mail.configurationType=properties
         in roller-jettyrun.properties. Jetty 11's MailSessionReference is incompatible
         with Jakarta Mail (angus-mail) so JNDI mail sessions aren't possible in dev. -->

</Configure>
