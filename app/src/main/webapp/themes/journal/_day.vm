## $model here is a PageModel
## $entry here is a WeblogEntryWrapper
##
## Quiet Journal day fragment. On the entry list (home page, search results)
## it emits the date-marginalia qj-entry row. On the permalink page
## ($model.permalink) it emits the reading view instead -- crumb, serif
## qj-h1, byline with the mono date, then the entry body inside the qj-prose
## reading column (58ch measure, blockquotes styled as the pull-quote
## treatment; see journal-custom.css) -- per
## docs/design/journal/journal-permalink.html.
<!-- _day -->
#if($model.permalink)
    #foreach($entry in $entries)
    <article class="qj-reading">
        ## $model.weblog.name is pre-escaped by WeblogWrapper#getName
        ## (StringEscapeUtils.escapeHtml4) -- emit it bare, or it double-encodes
        ## ("&amp;" -> "&amp;amp;"), same as frontpage/weblog.vm's $blog.name.
        <p class="qj-crumb"><a href="$url.home">$model.weblog.name</a> &middot; $utils.escapeHTML($entry.category.name)</p>
        <h1 class="qj-h1">$entry.title</h1>
        <p class="qj-byline">
            <span>By $utils.escapeHTML($entry.creator.screenName)</span>
            <span class="d">$utils.formatDate($entry.pubTime, "MMMM d, yyyy")</span>
        </p>
        <div class="qj-prose">$entry.displayContent</div>
    </article>
    #end
#else
#foreach($entry in $entries)
<article class="qj-entry">
    <p class="qj-date">$utils.formatDate($entry.pubTime, "MMM dd")<br>$utils.formatDate($entry.pubTime, "yyyy")</p>
    <div>
        <h3 class="qj-title"><a href="$url.entry($entry.anchor)">$entry.title</a></h3>
        #if($utils.isNotEmpty($entry.searchDescription))
        <p class="qj-sum">$utils.escapeHTML($entry.searchDescription)</p>
        #end
        <p class="qj-meta">In <b>$utils.escapeHTML($entry.category.name)</b> &middot; $entry.commentCount comments</p>
    </div>
</article>
#end
#end
