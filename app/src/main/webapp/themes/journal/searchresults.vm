<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; font-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    ## $model.weblog.name is pre-escaped by WeblogWrapper#getName
    ## (StringEscapeUtils.escapeHtml4) -- emit it bare, or it double-encodes
    ## ("&amp;" -> "&amp;amp;"), same as frontpage/weblog.vm's $blog.name.
    <title>Search results : $model.weblog.name</title>
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    <link rel="stylesheet" href="$model.weblog.stylesheet">
    #showSeoHead()
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showEmbedAssets()
    #showAudienceAssets()
    #showMapAssets()
</head>
<!-- searchresults -->
<body class="qj">

<header class="qj-head">
    <p class="qj-site"><a href="$url.home">$model.weblog.name</a></p>
    <nav class="qj-nav">
        <ul>
        #showPageLinks($model.weblog)
        </ul>
    </nav>
</header>

<main class="qj-main">
    #set($pager = $model.getWeblogEntriesPager())
    <div class="qj-search-head">
        #showWeblogSearchAgainForm($model.weblog)
        #if($model.hits > 0)
        <nav class="qj-pager">
            #showNextPrevSearchControl($pager)
        </nav>
        #end
    </div>
    ## SearchResultsModel.getErrorMessage() carries a WebloggerException's
    ## message (Lucene down, a malformed query) and was rendered by nothing,
    ## so a broken index looked exactly like a search that found nothing.
    ## Reported here with a FIXED sentence -- the exception text is internal
    ## detail on a public page, for the same reason the Velocity error
    ## templates may not print it. Checked before the zero-hit branch,
    ## because a failed search also reports zero hits.
    #if($utils.isNotEmpty($model.errorMessage))
    <p class="qj-search-error">Search is temporarily unavailable. Please try again shortly.</p>
    #elseif($model.hits == 0)
    <p class="qj-search-empty">No entries matched that search. Try a different word, or a shorter phrase.</p>
    #end
    <div class="qj-entries">
        #showWeblogEntriesPager($pager)
    </div>
</main>

</body>
</html>
