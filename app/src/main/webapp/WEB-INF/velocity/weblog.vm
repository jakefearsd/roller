#**
Set of essential macros needed in Roller velocity templates.
These are the documented macros in order defined in this file:

    #includeTemplate($weblog $pageName)
    #showAutodiscoveryLinks($weblog)
    #showSeoHead()
    #showEntryTitle($entry)
    #showPageTitle($page)
    #showMetaDescription()          (superseded by #showSeoHead)
    #showAnalyticsTrackingCode($weblog)
    #showResponsiveImage($image $alt $sizes $imgClass)
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showMapAssets()

    #showWeblogEntriesPager($pager)
    #showNextPrevEntriesControl($pager)
    #showMobileNextPrevEntriesControl($pager)

    #showWeblogEntryLinksList($entries)
    #showWeblogCategoryLinksList()
    #showMobileCategoryLinksList()
    #showAtomFeedsList($weblog)
    #showRSSFeedsList($weblog)

    #showWeblogEntryCalendar($weblog $category)

    #showPageMenu($weblog)
    #showAuthorMenu($vertical)

    #showWeblogSearchForm($weblog)
    #showMobileSearchForm($weblog)
    #showWeblogSearchAgainForm($weblog)
    #showMobileSearchAgainForm($weblog)
    #showNextPrevSearchControl($pager)
    #showMobileNextPrevSearchControl($pager)

    #showMobilePopupDialog($id $header $message)

    #_showCommonJavaScript()

    #showEntryTags($entry)
*#


#**
Parse and include page template from weblog.
*#
#macro(includeTemplate $weblog $pageName)
    #set($pageArg = false)## This is required for such constructs; see Velocity docs and ROL-689
    #set($pageArg = $weblog.getTemplateByName($pageName))
    #if ($pageArg)
       #set($pageId = $pageArg.id+'|standard')
       #parse($pageId)
    #end
#end


#**
Show RSS and Atom auto-discovery links as HTML link elements.
*#
#macro(showAutodiscoveryLinks $weblog)
    ## main feed urls are always available
    #if (!$model.searchResults)
    <link rel="alternate" type="application/atom+xml" title="Recent Entries (Atom)"  href="$url.feed.entries.atom" />
    <link rel="alternate" type="application/rss+xml"  title="Recent Entries (RSS)"   href="$url.feed.entries.rss" />

    #if ($model.tags)
      <link rel="alternate" type="application/atom+xml" title="Entries tagged $model.tags.toString() (Atom)"  href="$url.feed.entries.atomByTags($model.tags, false)" />
      <link rel="alternate" type="application/rss+xml"  title="Entries tagged $model.tags.toString() (RSS)"   href="$url.feed.entries.rssByTags($model.tags, false)" />
    #elseif ($model.weblogCategory)
      <link rel="alternate" type="application/atom+xml" title="Entries for category $model.weblogCategory.name (Atom)"  href="$url.feed.entries.atom($model.weblogCategory.name, false)" />
      <link rel="alternate" type="application/rss+xml"  title="Entries for category $model.weblogCategory.name (RSS)"   href="$url.feed.entries.rss($model.weblogCategory.name, false)" />
    #end

    #else
    <link rel="alternate" type="application/rss+xml"  title="Search results for '$utils.escapeHTML($model.term)'"  href="$utils.escapeHTML($url.feed.entries.search($model.term,$model.weblogCategory.name))" />
    #end
#end


#**
Emits the automatic SEO baseline for the current page and supersedes
#showMetaDescription (kept below for older custom themes). Call once from
inside the <head> element of every theme page template.

Emits, in order: a meta description (the entry search description on
permalinks, the static page's search description on a $model.page view,
else the weblog's about text), a robots noindex directive when the entry or
page asks for one, rel=canonical from $model.canonicalUrl (the per-entry or
per-page canonical override wins on its own view; search pages get none),
the Open Graph card, the Twitter card, and JSON-LD structured data
(BlogPosting on permalinks, Blog on the weblog's other pages -- including
static pages, which get no dedicated JSON-LD type of their own).

A static page ($model.page, a bare-slug WeblogPage -- see PageModel#getPage)
is treated as its own SEO subject, structurally parallel to a permalink
entry: metaTitle/searchDescription/canonicalUrl/noindex/ogImageId are the
same five fields WeblogEntry carries, just unwrapped (WeblogPage has no pojo
wrapper), so the page branch below reads them directly rather than through a
wrapper's sanitizing getters. og:type stays "website" for a page, same as
every other non-permalink view.

og:image sizing: the rendition ladder tops out at 2400px, but social-card
crawlers are happy with far less, so og:image points at the 1600px-wide
rendition when the source image is wider than 1600px AND its format is
rendition-eligible (jpeg/png -- for gif/bmp the servlet would silently
serve the full-size original at the ?w= URL, so the original URL and its
real dimensions are declared instead), and at the original URL otherwise
-- one URL, no srcset, keeps the card markup simple and never upscales.

Every user-controlled value is escaped on the way out: HTML-attribute
escaping via $utils.escapeHTML (a stored canonical URL or meta title
containing a double quote must not break out of its attribute) and JSON
string escaping via $utils.escapeJson (which also escapes "/", so a value
containing "</script>" cannot terminate the inline JSON-LD block).
*#
#macro(showSeoHead)
    #set($seoEntry = false)
    #if ($model.permalink && $model.weblogEntry)
        #set($seoEntry = $model.weblogEntry)
    #end
    ## A static page ($model.page, raw WeblogPage pojo -- see PageModel#getPage)
    ## is mutually exclusive with a permalink entry, never both on one request.
    #set($seoPage = false)
    #if (!$seoEntry && $model.page)
        #set($seoPage = $model.page)
    #end
    ## description: entry search description on permalinks, page search
    ## description on a static page, else weblog about.
    ## Values are read RAW off the pojo and escaped exactly once at emit time:
    ## the wrapper getters conditionally sanitize, which already entity-encodes
    ## quotes when the sanitizer is on (double-escaping) and passes everything
    ## through raw when it is off (no attribute safety at all). These are
    ## plain-text fields, so a single deterministic escape is both safer and
    ## cleaner than sanitizing.
    #set($seoDescription = false)
    #if ($seoEntry)
        #if ($utils.isNotEmpty($seoEntry.pojo.searchDescription))
            #set($seoDescription = $seoEntry.pojo.searchDescription)
        #end
    #elseif ($seoPage)
        #if ($utils.isNotEmpty($seoPage.searchDescription))
            #set($seoDescription = $seoPage.searchDescription)
        #end
    #elseif ($utils.isNotEmpty($model.weblog.pojo.about))
        #set($seoDescription = $model.weblog.pojo.about)
    #end
    #if ($seoDescription)
    <meta name="description" content="$utils.escapeHTML($seoDescription)">
    #end
    #if ($seoEntry && $seoEntry.noindex)
    <meta name="robots" content="noindex">
    #elseif ($seoPage && $seoPage.noindex)
    <meta name="robots" content="noindex">
    #end
    #set($seoCanonical = false)
    #set($seoCanonical = $model.canonicalUrl)
    #if ($seoCanonical)
    <link rel="canonical" href="$utils.escapeHTML($seoCanonical)">
    #end
    ## Open Graph card. The title needs per-source escaping, because the
    ## sources are stored differently:
    ##  - metaTitle (entry or page) is stored raw (a new field), so it is
    ##    escaped exactly once here, like the description above;
    ##  - the entry title is stored ALREADY HTML-escaped for UI-authored
    ##    entries (EntryBean.copyTo escapeHtml4, symmetric unescape in
    ##    copyFrom), which is why themes emit $entry.title raw -- so it must be
    ##    unescaped back to text before this macro's own escape, or "Fish &
    ##    Chips" ships as "Fish &amp;amp; Chips" on share cards and as a
    ##    literal entity in the JSON-LD headline. Unescape-then-escape-once
    ##    also keeps the attribute-escape guarantee for titles containing
    ##    quotes;
    ##  - the page title, unlike the entry title, is stored RAW (PageBean.copyTo
    ##    has no escapeHtml4 step -- page.vm's own <h1> escapes it at render
    ##    time the same way this macro does), so it needs no unescape first;
    ##  - the weblog name is already HTML-escaped by WeblogWrapper.getName(),
    ##    so escaping it again would render "&amp;" literally in the card title.
    #if ($seoEntry)
        ## $seoNamePlain is the RAW resolved title. It is escaped once per
        ## context below, and handed unescaped to $utils.travelJsonLd, which
        ## does its own escaping -- passing $seoTitleJson there would
        ## double-escape.
        #if ($utils.isNotEmpty($seoEntry.pojo.metaTitle))
            #set($seoNamePlain = $seoEntry.pojo.metaTitle)
        #else
            #set($seoNamePlain = $utils.unescapeHTML($seoEntry.pojo.title))
        #end
        #set($seoTitleAttr = $utils.escapeHTML($seoNamePlain))
        #set($seoTitleJson = $utils.escapeJson($seoNamePlain))
    #elseif ($seoPage)
        #if ($utils.isNotEmpty($seoPage.metaTitle))
            #set($seoNamePlain = $seoPage.metaTitle)
        #else
            #set($seoNamePlain = $seoPage.title)
        #end
        #set($seoTitleAttr = $utils.escapeHTML($seoNamePlain))
        #set($seoTitleJson = $utils.escapeJson($seoNamePlain))
    #else
        #set($seoTitleAttr = $model.weblog.name)
        #set($seoTitleJson = $utils.escapeJson($model.weblog.pojo.name))
    #end
    <meta property="og:type" content="#if($seoEntry)article#{else}website#end">
    <meta property="og:title" content="$seoTitleAttr">
    #if ($seoDescription)
    <meta property="og:description" content="$utils.escapeHTML($seoDescription)">
    #end
    #if ($seoCanonical)
    <meta property="og:url" content="$utils.escapeHTML($seoCanonical)">
    #end
    <meta property="og:site_name" content="$utils.escapeHTML($config.siteName)">
    ## dedicated og:image wins, else the featured image (wrapper getOgImage
    ## does not fall back on its own). A page has no featuredImage field of
    ## its own, so there is nothing to fall back to -- $model.pageOgImage is
    ## the whole answer.
    #set($seoImage = false)
    #if ($seoEntry)
        #set($seoImage = $seoEntry.ogImage)
        #if (!$seoImage)
            #set($seoImage = $seoEntry.featuredImage)
        #end
    #elseif ($seoPage)
        #set($seoImage = $model.pageOgImage)
    #end
    #if ($seoImage)
        ## The 1600px rendition only exists for rendition-eligible formats
        ## (jpeg/png); for anything else (gif, bmp, ...) the servlet silently
        ## serves the full-resolution original at the ?w= URL, so declaring
        ## 1600px dimensions there would lie to the card crawlers.
        #if ($seoImage.renditionEligible && $seoImage.width > 1600)
            #set($seoImageUrl = $seoImage.url(1600))
            #set($seoImageWidth = 1600)
            #set($seoImageHeight = 1600 * $seoImage.height / $seoImage.width)
        #else
            #set($seoImageUrl = $seoImage.permalink)
            #set($seoImageWidth = $seoImage.width)
            #set($seoImageHeight = $seoImage.height)
        #end
    <meta property="og:image" content="$utils.escapeHTML($seoImageUrl)">
        #if ($seoImageWidth > 0 && $seoImageHeight > 0)
    <meta property="og:image:width" content="$seoImageWidth">
    <meta property="og:image:height" content="$seoImageHeight">
        #end
    <meta name="twitter:card" content="summary_large_image">
    #else
    <meta name="twitter:card" content="summary">
    #end
    ## JSON-LD: BlogPosting on permalinks, Blog on the weblog's other pages.
    ##
    ## The BlogPosting block is emitted for EVERY permalink, unchanged, whatever
    ## the author picked in the SEO card -- a travel post is still a blog post,
    ## and its datePublished/dateModified/author/headline are what feeds and
    ## search rely on. When a travel type IS picked, a SECOND ld+json block
    ## follows carrying the typed object; consumers accept several blocks per
    ## page and associate them through the "url"/"mainEntityOfPage" both sides
    ## point at the same canonical URL.
    ##
    ## $utils.travelJsonLd returns that second object as finished, fully escaped
    ## JSON (EntryJsonLd builds it: variable-length itinerary and FAQ arrays are
    ## not something to comma-join by hand in a template), or null for "no
    ## second block" -- which covers BOTH a null jsonld_type and an explicit
    ## BLOG_POSTING, because EntryBean.copyTo normalizes a blank selection to
    ## BLOG_POSTING and a re-saved old entry must render exactly as before.
    ##
    ## The values are handed over RAW; EntryJsonLd escapes them once. The
    ## #set-to-"" dance is because these are Velocity's false-or-value idiom
    ## and a method argument must be a String either way.
    #if ($seoEntry)
        #set($seoAuthor = false)
        #set($seoAuthor = $seoEntry.creator)
        #set($seoDescriptionArg = "")
        #if ($seoDescription)
            #set($seoDescriptionArg = $seoDescription)
        #end
        #set($seoImageArg = "")
        #if ($seoImage)
            #set($seoImageArg = $seoImageUrl)
        #end
        #set($seoCanonicalArg = "")
        #if ($seoCanonical)
            #set($seoCanonicalArg = $seoCanonical)
        #end
        #set($seoTypedJson = false)
        #set($seoTypedJson = $utils.travelJsonLd($seoEntry.pojo, $seoNamePlain, $seoDescriptionArg, $seoImageArg, $seoCanonicalArg))
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        #if ($seoImage)"image": "$utils.escapeJson($seoImageUrl)",#end
        #if ($seoEntry.pubTime)"datePublished": "$utils.formatIso8601Date($seoEntry.pubTime)",#end
        #if ($seoEntry.updateTime)"dateModified": "$utils.formatIso8601Date($seoEntry.updateTime)",#end
        #if ($seoDescription)"description": "$utils.escapeJson($seoDescription)",#end
        #if ($seoAuthor)"author": { "@type": "Person", "name": "$utils.escapeJson($seoAuthor.screenName)" },#end
        "mainEntityOfPage": "$utils.escapeJson($seoCanonical)",
        "headline": "$seoTitleJson"
    }
    </script>
        #if ($seoTypedJson)
    <script type="application/ld+json">
    $seoTypedJson
    </script>
        #end
    #elseif (!$model.searchResults)
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Blog",
        #if ($seoDescription)"description": "$utils.escapeJson($seoDescription)",#end
        #if ($seoCanonical)"url": "$utils.escapeJson($seoCanonical)",#end
        "name": "$utils.escapeJson($model.weblog.pojo.name)"
    }
    </script>
    #end
#end


#**
Emits the text for an entry page's <title> element: the entry's SEO meta
title when one is set, else the entry title (raw, exactly as the themes
have always emitted it). The meta title is a new field so it is
HTML-escaped on the way out.
*#
#macro(showEntryTitle $entry)#if($utils.isNotEmpty($entry.pojo.metaTitle))$utils.escapeHTML($entry.pojo.metaTitle)#else$entry.title#end#end


#**
The #showEntryTitle twin for a static page ($model.page): emits the text for
its <title> element, the page's SEO meta title when one is set, else the
page title. Unlike an entry title, a page title is stored RAW (PageBean.copyTo
has no escapeHtml4 step, unlike EntryBean.copyTo), so -- unlike
#showEntryTitle -- BOTH branches here are HTML-escaped, not just the meta
title one.
*#
#macro(showPageTitle $page)#if($utils.isNotEmpty($page.metaTitle))$utils.escapeHTML($page.metaTitle)#else$utils.escapeHTML($page.title)#end#end


#**
SUPERSEDED by #showSeoHead, which emits this same meta description plus the
rest of the SEO baseline; kept for older custom themes that still call it.

Adds a meta description tag, suitable for use in HTML header sections.  This tag is frequently used by
search engines to provide a short description for links returned.  The description value will set to the
weblog's tagline if on a multiple blog entry page or the weblog entry search description if on a single
blog entry (permalink) page.  If the relevant description value has not been configured no meta tag
will be created.
*#
#macro(showMetaDescription)
    #if ($model.permalink)
        #if ($utils.isNotEmpty($model.weblogEntry.searchDescription))
            <meta name="description" content="$model.weblogEntry.searchDescription">
        #end
    #elseif ($utils.isNotEmpty($model.weblog.about))
        <meta name="description" content="$model.weblog.about">
    #end
#end

#**
Analytics for a weblog. The structured path: a validated Umami website id
plus startup config builds the script tag HERE, so no admin-typed markup
ever reaches the head -- which is what lets per-weblog analytics coexist
with weblogAdminsUntrusted. Same-origin via Caddy's /analytics handle, so
the pinned theme CSPs are untouched. The legacy raw-snippet branches remain
for installations that used them.
*#
#macro(showAnalyticsTrackingCode $weblog)
    #if ($utils.isNotEmpty($weblog.analyticsSiteId))
<script defer src="$config.analyticsBasePath/$config.analyticsScriptName" data-website-id="$utils.escapeHTML($weblog.analyticsSiteId)" data-host-url="$config.analyticsBasePath"></script>
    #elseif ($config.analyticsOverrideAllowed && $utils.isNotEmpty($weblog.analyticsCode))
        $weblog.analyticsCode
    #elseif ($utils.isNotEmpty($config.defaultAnalyticsTrackingCode))
        $config.defaultAnalyticsTrackingCode
    #end
#end

#**
Renders an uploaded image (a MediaFileWrapper, e.g. $entry.featuredImage)
as a responsive <picture> whose srcset climbs the rendition ladder -- the
theme-side twin of the [image] entry shortcode, emitting the same markup.

$image    a MediaFileWrapper; the macro emits nothing when it is false/null
$alt      alt text, HTML-escaped on the way out
$sizes    the sizes attribute value, e.g. "100vw" for a full-column hero
          or "240px" for a fixed-width card thumb
$imgClass CSS class for the <img> (pass "" for none)

srcset (and the webp <source>, negotiated via the Accept header on the same
URLs) is only offered when the wrapper reports a srcset at all: for formats
outside the rendition ladder (gif/bmp) and for pre-ladder uploads without
width metadata the image degrades to a plain, honest <img src>. When the
file has a BlurHash, its average color is emitted as an inline background
so the reserved box shows a plausible color while the pixels load --
a dependency-free, JS-free blur-up.
*#
#macro(showResponsiveImage $image $alt $sizes $imgClass)
#if ($image)
#set($responsiveSrcset = false)
#set($responsiveSrcset = $image.srcset)
#set($responsiveAvgColor = false)
#set($responsiveAvgColor = $image.averageColor)
## Focal point (when set) becomes an inline object-position so themes that
## crop the image to fit (object-fit:cover heroes/cards) keep the subject in
## frame. Theme-side markup only: this macro's output is never sanitized,
## unlike entry content, where the [image] shortcode deliberately omits it.
#set($responsiveObjectPosition = false)
#set($responsiveObjectPosition = $image.objectPosition)
<picture>
#if ($responsiveSrcset)
<source type="image/webp" srcset="$responsiveSrcset" sizes="$sizes">
#end
<img src="$image.permalink"#if ($responsiveSrcset) srcset="$responsiveSrcset" sizes="$sizes"#end#if ($image.width > 0 && $image.height > 0) width="$image.width" height="$image.height"#end alt="$utils.escapeHTML($alt)" loading="lazy" decoding="async"#if ($imgClass && $imgClass != "") class="$imgClass"#end#if ($utils.isNotEmpty($image.blurhash)) data-blurhash="$utils.escapeHTML($image.blurhash)"#end#if ($responsiveAvgColor && $responsiveObjectPosition) style="background-color:$responsiveAvgColor;object-position:$responsiveObjectPosition"#elseif ($responsiveAvgColor) style="background-color:$responsiveAvgColor"#elseif ($responsiveObjectPosition) style="object-position:$responsiveObjectPosition"#end>
</picture>
#end
#end


#**
Emits the stylesheet for the [gallery] shortcode's justified grid as an
inline <style> block (allowed by the themes' style-src 'unsafe-inline';
entry content itself may not carry <style>, which is why this lives in the
theme head and the shortcode only emits classes and CSS custom properties).

Call it from every theme head, next to #showSeoHead. The shortcode emits
<div class="jgrid"> containing one <figure style="--ar:w/h"> per image
(anchor-wrapped for the lightbox); rows pack justified via flex-grow, the
row height comes from --row-h (overridable per gallery through the
shortcode's row attribute), and aspect-ratio reserves each box before the
image loads, so there is no layout shift. NOTE: these rules deliberately
live here, not in a shared stylesheet -- no theme head links one, so rules
there would never load.
*#
#macro(showGalleryGridStyles)
##
## The rules are generated in GalleryMarkup.gridStyles() from the same
## constants that produce the figures' ar-NNN classes, so a class the emitter
## can produce and the stylesheet has no rule for cannot exist. They used to be
## written out by hand here, kept in sync with the emitter only by care; when
## the emitter moved to classes that hand-written copy could just as easily
## have gone stale unnoticed.
##
<style>
$utils.galleryGridStyles
</style>
#end


#**
Emits the PhotoSwipe 5 lightbox assets for the [gallery] justified grid:
the webjar stylesheet, a small <style> block for the caption and EXIF
chrome, and a module script that binds PhotoSwipeLightbox to every .jgrid
container. The grid anchors carry the whole payload -- href to the
full-size original, data-pswp-width/height, data-caption, data-exif-* and
data-blurhash, all null-skipped -- see GalleryShortcode.

Call it from every theme head, next to #showGalleryGridStyles. The link
and this bootstrap script are emitted unconditionally: the head renders
before entry content, so the page cannot know server-side whether a
gallery will appear without pre-expanding the shortcode. The accepted cost
on gallery-less pages is one small cacheable stylesheet request plus a
single querySelector; the expensive part stays lazy, because the script
import()s the PhotoSwipe ES modules only after finding a .jgrid in the
document.

CSP notes: every asset is same-origin, so the module imports clear
script-src 'self' and this inline bootstrap rides 'unsafe-inline';
PhotoSwipe's chrome is inline SVG, not an icon font, so the themes'
font-less CSP (default-src 'none', no font-src) cannot blank it.
The photoswipe version in the three /webjars/ URLs below is guarded by
WebjarReferenceTest against the org.webjars.npm:photoswipe dependency in
app/pom.xml -- update both together.
*#
#macro(showGalleryAssets)
<link rel="stylesheet" href="$url.site/webjars/photoswipe/5.4.3/dist/photoswipe.css">
<style>
.pswp__custom-caption {
  position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%);
  max-width: calc(100% - 32px); padding: 3px 10px; border-radius: 4px;
  background: rgba(0, 0, 0, 0.55); color: white;
  font-size: 0.9em; text-align: center;
}
.pswp__exif {
  position: absolute; right: 12px; top: 56px; max-width: 60%;
  padding: 3px 10px; border-radius: 4px;
  background: rgba(0, 0, 0, 0.55); color: white;
  font-size: 0.8em; text-align: right;
}
</style>
<script type="module">
if (document.querySelector('.jgrid')) {
  const { default: PhotoSwipeLightbox } =
      await import('$url.site/webjars/photoswipe/5.4.3/dist/photoswipe-lightbox.esm.min.js');
  const lightbox = new PhotoSwipeLightbox({
    gallery: '.jgrid',
    children: 'a',
    pswpModule: () => import('$url.site/webjars/photoswipe/5.4.3/dist/photoswipe.esm.min.js')
  });
  // Low-res placeholder while the original downloads: prefer the grid
  // thumbnail already on screen, else the server-side ?t=true rendition.
  // The grid img also paints the blurhash average colour as its background,
  // so the zoom-in never starts from a white flash.
  lightbox.addFilter('itemData', (itemData) => {
    const anchor = itemData.element;
    if (anchor && !itemData.msrc) {
      const img = anchor.querySelector('img');
      itemData.msrc = (img && (img.currentSrc || img.src)) || (itemData.src + '?t=true');
    }
    return itemData;
  });
  lightbox.on('uiRegister', () => {
    const pswp = lightbox.pswp;
    pswp.ui.registerElement({
      name: 'custom-caption', order: 9, isButton: false, appendTo: 'root',
      onInit: (el) => {
        pswp.on('change', () => {
          const anchor = pswp.currSlide.data.element;
          const figure = anchor ? anchor.closest('figure') : null;
          const caption = figure ? figure.querySelector('figcaption') : null;
          el.textContent = caption ? caption.textContent : '';
          el.hidden = !caption;
        });
      }
    });
    pswp.ui.registerElement({
      name: 'exif', order: 10, isButton: false, appendTo: 'root',
      onInit: (el) => {
        pswp.on('change', () => {
          const anchor = pswp.currSlide.data.element;
          const data = anchor ? anchor.dataset : {};
          const gear = [data.exifCamera, data.exifLens]
              .filter(Boolean).join(', ');
          const settings = [
            data.exifFocal, data.exifAperture, data.exifExposure,
            data.exifIso ? 'ISO ' + data.exifIso : ''
          ].filter(Boolean).join(' · ');
          const text = [gear, settings].filter(Boolean).join(' — ');
          el.textContent = text;
          el.hidden = !text;
        });
      }
    });
  });
  lightbox.init();
}
</script>
#end


#**
Emits the Leaflet assets for the [map] shortcode: the webjar stylesheet, a
small <style> block giving .travel-map a height (a Leaflet container with no
height renders nothing at all), and a bootstrap script that turns every
<div class="travel-map"> the shortcode emitted into a real map.

Call it from every theme head, next to #showGalleryAssets -- all nine
#showSeoHead call sites across the five bundled themes. Missing one is a
silent failure: the div still renders and simply never becomes a map.
MapAssetsRenderingTest renders all nine and counts.

Lazy, the same bargain #showGalleryAssets documents: the head is rendered
before entry content, so the page cannot know server-side whether a map will
appear. The 3.5 KiB stylesheet ships unconditionally; leaflet.js is 41 KiB
gzipped and is injected only after a .travel-map is actually found. This is a
classic script rather than the gallery's ES module because leaflet.js ships as
UMD (it ends in `window.L = t`) -- a classic script is the shape it is built
for. A classic inline script in <head> runs before <body> is parsed, so the
presence check has to wait for DOMContentLoaded.

The markup contract comes from MapShortcode: data-pins is an HTML-encoded
one-line JSON array of {lat,lng,label}, data-center is "lat,lng", data-zoom a
positive integer, data-route="true" when a polyline was asked for and there
are at least two pins. Labels are the author's literal text and are set with
textContent, never innerHTML.

L.Icon.Default is pinned to absolute webjar URLs here rather than left to
Leaflet's own path detection, which reads a computed background-image off a
throwaway div and caches whatever it finds -- including the wrong answer --
on a static field for the life of the page. Setting imagePath to the empty
string alongside the absolute URLs both satisfies the "is it a string?" check
that would otherwise trigger detection and keeps the prefix Leaflet
concatenates harmless.

Tile policy (operations.osmfoundation.org/policies/tiles/): the tile template
comes from $config.mapTileUrl (roller.properties travel.map.tileUrl) so a
deployer can point it elsewhere; there is no {s} subdomain placeholder,
attribution is required and therefore never suppressed, maxZoom is raised
from Leaflet's default 18 to the 19 the OSM standard layer renders, and tiles
are fetched browser-direct -- never proxied through Roller, whose Java
User-Agent the policy blocks. The template is interpolated straight into a
single-quoted JS string, so a deployer overriding it must not put an apostrophe
in it; it is deployer-owned static config, at the same trust level as
analytics.default.tracking.code, and never author or reader input.

CSP: every asset is same-origin, Leaflet has no eval/fetch and injects no
stylesheet, so the themes' policy covers it unchanged except for one thing --
Leaflet paints aborted and out-of-range tiles with a data: GIF placeholder
and CSP3's * wildcard does not match data:, which is why all seven declaring
heads carry `img-src * data:`. Do not add a restrictive Referrer-Policy (the
OSM policy forbids it) or require-trusted-types-for 'script' (Leaflet assigns
innerHTML in eleven places and would throw).

The leaflet version in the five /webjars/ URLs below is guarded by
WebjarReferenceTest against the org.webjars.npm:leaflet dependency in
app/pom.xml -- update both together.
*#
#macro(showMapAssets)
#set($mapTileUrl = $config.mapTileUrl)
#if(!$mapTileUrl || $mapTileUrl.isEmpty())#set($mapTileUrl = "https://tile.openstreetmap.org/{z}/{x}/{y}.png")#end
<link rel="stylesheet" href="$url.site/webjars/leaflet/1.9.4/dist/leaflet.css">
<style>
.travel-map { height: 380px; max-width: 100%; margin: 1em 0; }
.travel-map .leaflet-popup-content { word-break: break-word; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var containers = document.querySelectorAll('.travel-map');
  if (!containers.length) { return; }
  var script = document.createElement('script');
  script.src = '$url.site/webjars/leaflet/1.9.4/dist/leaflet.js';
  script.onload = function () {
    // BEFORE any marker is constructed, or Leaflet's path heuristic runs
    // and caches its guess on the static field for the whole page.
    L.Icon.Default.mergeOptions({
      iconUrl: '$url.site/webjars/leaflet/1.9.4/dist/images/marker-icon.png',
      iconRetinaUrl: '$url.site/webjars/leaflet/1.9.4/dist/images/marker-icon-2x.png',
      shadowUrl: '$url.site/webjars/leaflet/1.9.4/dist/images/marker-shadow.png'
    });
    L.Icon.Default.imagePath = '';
    Array.prototype.forEach.call(containers, initMap);
  };
  document.head.appendChild(script);

  function readPins(el) {
    // the browser has already decoded the attribute entities for us
    if (!el.dataset.pins) { return []; }
    try {
      var parsed = JSON.parse(el.dataset.pins);
      return Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      return [];
    }
  }

  function readCenter(el) {
    if (!el.dataset.center) { return null; }
    var parts = el.dataset.center.split(',');
    var lat = parseFloat(parts[0]);
    var lng = parseFloat(parts[1]);
    return isFinite(lat) && isFinite(lng) ? [lat, lng] : null;
  }

  function initMap(el) {
    var pins = readPins(el);
    var center = readCenter(el);
    var zoom = parseInt(el.dataset.zoom, 10);
    var authorZoom = zoom > 0 && zoom <= 19;
    var points = [];
    var i;
    for (i = 0; i < pins.length; i++) {
      var lat = Number(pins[i].lat);
      var lng = Number(pins[i].lng);
      if (isFinite(lat) && isFinite(lng)) {
        points.push([lat, lng, pins[i].label]);
      }
    }
    if (!points.length && !center) { return; }

    // A view has to exist before layers are added; fitBounds refines it below.
    var start = center || [points[0][0], points[0][1]];
    var map = L.map(el).setView(start, authorZoom ? zoom : 13);
    L.tileLayer('$mapTileUrl', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    var latlngs = [];
    for (i = 0; i < points.length; i++) {
      latlngs.push([points[i][0], points[i][1]]);
      var marker = L.marker([points[i][0], points[i][1]]).addTo(map);
      if (points[i][2]) {
        // author text, never markup: a label is whatever they typed
        var label = document.createElement('span');
        label.textContent = points[i][2];
        marker.bindPopup(label);
      }
    }
    if (el.dataset.route === 'true' && latlngs.length > 1) {
      L.polyline(latlngs).addTo(map);
    }
    // An explicit zoom= is the author overriding the fit; otherwise frame the
    // pins, capped so a single pin does not slam to street level.
    if (latlngs.length && !authorZoom) {
      map.fitBounds(latlngs, { padding: [24, 24], maxZoom: 15 });
    }
  }
});
</script>
#end


#**
Click-to-play video embeds for the [video] shortcode -- the twin of
#showMapAssets and #showGalleryAssets.

Nothing loads from the provider until a reader clicks: the shortcode emits a
thumbnail and this macro swaps in the frame on demand. That is a privacy
property, not only a performance one, and it is why the theme CSP needs
frame-src but not connect-src for these hosts.
*#
#macro(showEmbedAssets)
<style>
.video-figure { margin: 1em 0; }
.video-embed { position: relative; aspect-ratio: 16 / 9; background: #000; cursor: pointer; }
.video-embed img, .video-embed iframe { width: 100%; height: 100%; border: 0; display: block; object-fit: cover; }
.video-embed::after { content: "\25B6"; position: absolute; inset: 0; display: flex;
  align-items: center; justify-content: center; font-size: 3rem; color: #fff;
  text-shadow: 0 0 12px rgba(0,0,0,.7); pointer-events: none; }
.video-embed.is-playing { cursor: default; }
.video-embed.is-playing::after { display: none; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var embeds = document.querySelectorAll('.video-embed');
  if (!embeds.length) { return; }
  Array.prototype.forEach.call(embeds, function (embed) {
    embed.addEventListener('click', function () {
      if (embed.classList.contains('is-playing')) { return; }
      var provider = embed.getAttribute('data-provider');
      var id = embed.getAttribute('data-video-id');
      if (!provider || !id) { return; }
      var src = provider === 'vimeo'
        ? 'https://player.vimeo.com/video/' + encodeURIComponent(id) + '?autoplay=1'
        : 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1';
      var frame = document.createElement('iframe');
      frame.setAttribute('src', src);
      frame.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
      frame.setAttribute('allowfullscreen', 'allowfullscreen');
      frame.setAttribute('title', 'Embedded video');
      embed.innerHTML = '';
      embed.appendChild(frame);
      embed.classList.add('is-playing');
    });
  });
});
</script>
#end


#**
Client-side injection for the [contact] and [subscribe] placeholders -- the
audience twin of #showEmbedAssets.

The sanitizer strips <form> from authored content on purpose (an authored
form is a phishing kit), so the shortcodes emit inert divs and this macro
builds the real forms. Both endpoints are same-origin, which is why no theme
CSP changes: connect-src 'self' already allows the fetches.

The hidden "website" field is a honeypot: bots fill every field, humans
never see it. elapsedMs is a naive-bot timer: the server refuses a submit
faster than a human could type. Neither is secret; neither needs to be.
*#
#macro(showAudienceAssets)
<style>
.contact-form label, .newsletter-subscribe label { display: block; margin-top: .75em; }
.contact-form input, .contact-form textarea, .newsletter-subscribe input[type=email] {
  width: 100%; max-width: 32em; padding: .4em; box-sizing: border-box; }
.contact-form textarea { min-height: 8em; }
.contact-form button, .newsletter-subscribe button { margin-top: .75em; padding: .4em 1.2em; }
.audience-hp { position: absolute; left: -9999px; top: -9999px; }
.audience-message { margin-top: .75em; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var loadedAt = Date.now();

  function showMessage(container, text) {
    var p = container.querySelector('.audience-message');
    p.hidden = false;
    p.textContent = text;
  }

  // Both slots' data-endpoint is server-built (ContactShortcode/
  // SubscribeShortcode/#showSubscribeForm), never derived here: the app's
  // context path cannot be reliably guessed from the page, and guessing it
  // wrong used to post to the wrong origin with no visible cause. This is a
  // second, cheap check on TOP of that -- an authored div anywhere in
  // same-origin content could otherwise point data-endpoint at any
  // same-origin path and have this script build a real PII-bearing form
  // around it; requiring the exact suffix this slot may legitimately point
  // to closes that residual without any fallback/guessing logic.
  function endpointOk(endpoint, suffix) {
    return !!endpoint && endpoint.length >= suffix.length
        && endpoint.slice(-suffix.length) === suffix;
  }

  Array.prototype.forEach.call(document.querySelectorAll('.contact-form-slot'), function (slot) {
    var handle = slot.getAttribute('data-weblog');
    var endpoint = slot.getAttribute('data-endpoint');
    if (!handle || !endpointOk(endpoint, '/roller-ui/rendering/contact.rol')) { return; }
    var form = document.createElement('form');
    form.className = 'contact-form';
    form.innerHTML =
        '<label>Name <input name="name" required maxlength="255"></label>'
      + '<label>Email <input type="email" name="email" required maxlength="255" autocomplete="email"></label>'
      + '<label>Subject <input name="subject" maxlength="255"></label>'
      + '<label>Message <textarea name="message" required maxlength="4000"></textarea></label>'
      + '<label class="audience-hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>'
      + '<button type="submit">Send</button>'
      + '<p class="audience-message" hidden></p>';
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      showMessage(form, 'Sending…');
      fetch(endpoint, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          weblog: handle,
          name: form.name.value,
          email: form.email.value,
          subject: form.subject.value,
          message: form.message.value,
          website: form.website.value,
          elapsedMs: Date.now() - loadedAt,
          source: window.location.pathname
        })
      }).then(function (response) {
        showMessage(form, response.ok
            ? 'Thanks — your message has been sent.'
            : 'Sorry, that did not work. Please try again later.');
        if (response.ok) { form.querySelector('button').disabled = true; }
      }).catch(function () {
        showMessage(form, 'Sorry, that did not work. Please try again later.');
      });
    });
    slot.appendChild(form);
  });

  Array.prototype.forEach.call(document.querySelectorAll('.subscribe-form-slot'), function (slot) {
    var uuid = slot.getAttribute('data-list-uuid');
    var endpoint = slot.getAttribute('data-endpoint');
    if (!uuid || !endpointOk(endpoint, '/newsletter/subscribe')) { return; }
    var form = document.createElement('form');
    form.className = 'newsletter-subscribe';
    form.innerHTML =
        '<label>Email <input type="email" name="email" required maxlength="255" autocomplete="email" placeholder="you@example.com"></label>'
      + '<label class="audience-hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>'
      + '<button type="submit">Subscribe</button>'
      + '<p class="audience-message" hidden></p>';
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      showMessage(form, 'Subscribing…');
      fetch(endpoint, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          email: form.email.value,
          list_uuids: [uuid],
          website: form.website.value,
          elapsedMs: Date.now() - loadedAt
        })
      }).then(function (response) {
        showMessage(form, (response.ok || response.status === 409)
            ? 'Thanks — please check your email to confirm.'
            : 'Sorry, that did not work. Please try again later.');
      }).catch(function () {
        showMessage(form, 'Sorry, that did not work. Please try again later.');
      });
    });
    slot.appendChild(form);
  });
});
</script>
#end


