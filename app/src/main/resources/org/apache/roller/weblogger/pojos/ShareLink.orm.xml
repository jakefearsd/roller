<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">
    <package>org.apache.roller.weblogger.pojos</package>
    <entity metadata-complete="true" name="ShareLink"
            class="org.apache.roller.weblogger.pojos.ShareLink" access="PROPERTY">
        <table name="roller_share_link"/>
        <named-query name="ShareLink.getByToken">
            <query>SELECT s FROM ShareLink s WHERE s.token = ?1</query>
        </named-query>
        <named-query name="ShareLink.getByWeblog">
            <query>SELECT s FROM ShareLink s WHERE s.weblog = ?1 ORDER BY s.created DESC</query>
        </named-query>
        <named-query name="ShareLink.getByTarget">
            <query>SELECT s FROM ShareLink s WHERE s.targetType = ?1 AND s.targetId = ?2 ORDER BY s.created DESC</query>
        </named-query>
        <named-query name="ShareLink.removeByWeblog">
            <query>DELETE FROM ShareLink s WHERE s.weblog = ?1</query>
        </named-query>
        <attributes>
            <id name="id">
                <column name="id"/>
            </id>
            <basic name="targetType">
                <column name="target_type" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <basic name="targetId">
                <column name="target_id" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <basic name="token">
                <column name="token" insertable="true" updatable="true" unique="true" nullable="false"/>
            </basic>
            <basic name="passwordHash">
                <column name="password_hash" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="created">
                <column name="created" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <basic name="expires">
                <column name="expires" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <many-to-one name="weblog" target-entity="org.apache.roller.weblogger.pojos.Weblog">
                <join-column name="weblogid" insertable="true" updatable="true" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>
</entity-mappings>
