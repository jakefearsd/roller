<beans:beans xmlns="http://www.springframework.org/schema/security"
       xmlns:beans="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/security
                           http://www.springframework.org/schema/security/spring-security.xsd">

    <http pattern="/images/**" security="none"/>
    <http pattern="/scripts/**" security="none"/>
    <http pattern="/styles/**" security="none"/>

    <!-- use-authorization-manager defaults to true (and its predecessor,
         the AccessDecisionManager/SecurityMetadataSource path this <http>
         element used until Stage 1B Task 3, is no longer just deprecated
         but gone: Spring Security 7.1, pulled in transitively by Spring
         Boot 4.1's BOM, ships spring-security-core without
         org.springframework.security.access.SecurityConfig, so
         access-decision-manager-ref="accessDecisionManager" with
         use-authorization-manager="false" throws NoClassDefFoundError the
         moment this file is parsed. use-authorization-manager is omitted
         below to take that true default; the accessDecisionManager/
         roleVoter beans that configured the old path are gone too (see
         below), replaced by the GrantedAuthorityDefaults bean, which is the
         AuthorizationManager-path equivalent of roleVoter's
         rolePrefix="": Roller's own granted authorities are bare role
         names ("admin", "editor", see RollerUserDetailsService), not
         Spring Security's default ROLE_-prefixed form.

         use-expressions is flipped from false to true alongside this:
         AuthorizationFilterParser (the AuthorizationManager-path
         intercept-url parser) rejects use-expressions="false" outright
         ("AuthorizationManager must be used with use-expressions=true")
         unless use-authorization-manager="false" is also present, and
         that combination is exactly the removed SecurityConfig path this
         change is getting away from. The plain comma-separated role lists
         below (access="admin,editor") are rewritten as the equivalent
         hasRole()/hasAnyRole() SpEL expressions; hasRole() still honors the
         GrantedAuthorityDefaults rolePrefix="" bean below, so the actual
         authorization decision (which roles satisfy which pattern) is
         unchanged from before. -->
    <http auto-config="false" use-expressions="true">
        <intercept-url pattern="/roller-ui/login-redirect**" access="hasAnyRole('admin','editor')"/>
        <intercept-url pattern="/roller-ui/profile**" access="hasAnyRole('admin','editor')"/>
        <intercept-url pattern="/roller-ui/createWeblog**" access="hasAnyRole('admin','editor')"/>
        <intercept-url pattern="/roller-ui/menu**" access="hasAnyRole('admin','editor')"/>
        <intercept-url pattern="/roller-ui/authoring/**" access="hasAnyRole('admin','editor')"/>
        <intercept-url pattern="/roller-ui/admin/**" access="hasRole('admin')"/>
        <!-- setup.rol lists every weblog plus user/blog counts, and setup!save.rol
             writes the site.frontpage.weblog.* runtime properties. Neither
             SetupController nor this file previously required a role, so any
             anonymous visitor could read the site inventory and repoint the site
             front page - the CSRF token is no defence, since an anonymous GET of
             the form hands one out. -->
        <intercept-url pattern="/roller-ui/setup**" access="hasRole('admin')"/>
        <intercept-url pattern="/rewrite-status*" access="hasRole('admin')"/>
        <!-- Catch-all, must be last (first-match-wins). The legacy
             SecurityMetadataSource path (use-authorization-manager="false")
             implicitly permitted any URL not matched by an <intercept-url>
             above; RequestMatcherDelegatingAuthorizationManager (the
             AuthorizationManager-path equivalent this file now uses) has no
             such implicit fallback: an unmatched request is denied, sending
             it through the same login-page redirect as a real
             AccessDeniedException, which loops forever when the login page
             itself is unmatched (i.e. this exact element was missing).
             permitAll() here restores the old default: only the six
             patterns above are actually gated; per-action authorization
             below that (UISecurityEnforced, checked by
             RollerHandlerInterceptor) is unaffected either way. -->
        <intercept-url pattern="/**" access="permitAll()"/>

        <form-login login-page="/roller-ui/login.rol"
                    username-parameter="j_username" 
                    password-parameter="j_password" 
                    authentication-failure-url="/roller-ui/login.rol?error=true"
                    login-processing-url="/roller_j_security_check"/>

        <remember-me services-ref="rollerRememberMeServices"
                     key="715F2448-3176-11DD-ABC6-9CD955D89593"/>

        <!-- OpenID support removed in Spring Security 6; OIDC via OAuth2 is the replacement.
             To re-enable, implement OIDC-based authentication. -->

        <!-- some roller UI (i.e. media file editor) uses iframes -->
        <headers>
            <frame-options policy="SAMEORIGIN"/>
        </headers>
    </http>

    <!-- Equivalent, under the AuthorizationManager path, of the old
         roleVoter's rolePrefix="": picked up by type (not by bean name)
         via GrantedAuthorityDefaultsParserUtils, which every <http>/
         <intercept-url> element above implicitly consults when building its
         AuthorityAuthorizationManager. Without this, "admin"/"editor" in
         the access="..." lists above would never match, since Spring
         Security's own default role prefix is "ROLE_" and
         RollerUserDetailsService grants bare role names. -->
    <beans:bean class="org.springframework.security.config.core.GrantedAuthorityDefaults">
        <beans:constructor-arg value=""/>
    </beans:bean>

    <!-- Read users from Roller API -->
    <authentication-manager alias='rollerAuthenticationManager'>
        <authentication-provider ref="rememberMeAuthenticationProvider"/>
        <authentication-provider user-service-ref="rollerUserService"/>
    </authentication-manager>

    <beans:bean id="rollerUserService"
                class="org.apache.roller.weblogger.ui.core.security.RollerUserDetailsService"/>

    <beans:bean id="rollerRememberMeServices"
                class="org.apache.roller.weblogger.ui.core.security.RollerRememberMeServices">
        <beans:constructor-arg name="userDetailsService" ref="rollerUserService"/>
    </beans:bean>

    <beans:bean id="rememberMeAuthenticationProvider"
                class="org.apache.roller.weblogger.ui.core.security.RollerRememberMeAuthenticationProvider">
    </beans:bean>

    <!-- OpenID beans removed (Spring Security 6); kept commented for reference:
    <beans:bean id="openIDAuthProvider" class="org.springframework.security.openid.OpenIDAuthenticationProvider">
        <beans:property name="userDetailsService" ref="rollerUserService"/>
    </beans:bean>
    <beans:bean id="openidAuthenticationProcessingFilter"
                class="org.apache.roller.weblogger.ui.core.filters.CustomOpenIDAuthenticationProcessingFilter">
        <beans:property name="filterProcessesUrl" value="/roller_j_openid_security_check"/>
        <beans:property name="authenticationManager" ref="rollerAuthenticationManager"/>
        <beans:property name="authenticationSuccessHandler" ref="myAuthenticationSuccessHandler"/>
        <beans:property name="authenticationFailureHandler" ref="myAuthenticationFailureHandler"/>
    </beans:bean>
    -->

    <beans:bean id="myAuthenticationSuccessHandler"
                class="org.springframework.security.web.authentication.SimpleUrlAuthenticationSuccessHandler">
        <beans:property name="defaultTargetUrl" value="/roller-ui/menu.rol"/>
    </beans:bean>

    <beans:bean id="myAuthenticationFailureHandler"
                class="org.springframework.security.web.authentication.ExceptionMappingAuthenticationFailureHandler">
        <beans:property name="defaultFailureUrl" value="/roller-ui/login.rol?error=true"/>
        <beans:property name="exceptionMappings">
            <beans:props>
                <beans:prop key="org.springframework.security.core.userdetails.UsernameNotFoundException">
                    /roller-ui/login.rol?error=true
                </beans:prop>
                <beans:prop key="org.springframework.security.authentication.BadCredentialsException">
                    /roller-ui/login.rol?error=true
                </beans:prop>
                <beans:prop key="org.springframework.security.core.AuthenticationException">
                    /roller-ui/login.rol?error=true
                </beans:prop>
            </beans:props>
        </beans:property>
    </beans:bean>

    
</beans:beans>
