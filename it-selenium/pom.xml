<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.roller</groupId>
        <artifactId>roller-project</artifactId>
        <version>6.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>roller-selenium-tests</artifactId>
    <name>Roller browser integration tests</name>
    <description>
        Selenide integration tests. The WAR is deployed to Tomcat by cargo against a
        dedicated PostgreSQL container whose schema is built by the real
        bin/db/migrations chain. Every test inherits browser-health checking, so a page
        that renders while its assets 404 fails rather than passing.

        Runs under `mvn verify -Pit`; excluded from the default build because it costs
        minutes rather than seconds.
    </description>

    <properties>
        <!-- Versions match the sibling jspwiki/wikantik Selenide suite. -->
        <selenide.version>7.17.0</selenide.version>
        <selenium.version>4.46.0</selenium.version>
        <cargo.plugin.version>1.10.20</cargo.plugin.version>
        <docker.plugin.version>0.48.1</docker.plugin.version>
        <build-helper.version>3.6.0</build-helper.version>
        <exec.plugin.version>3.6.3</exec.plugin.version>
        <maven-clean.version>3.5.0</maven-clean.version>

        <!-- Tomcat 10.1, not 9: Roller uses jakarta.servlet 6.0, which Tomcat 9
             (Java EE 8, javax.*) cannot run. -->
        <it.tomcat.version>10.1.57</it.tomcat.version>

        <it.db.name>roller_it</it.db.name>
        <it.db.user>roller</it.db.user>
        <it.db.password>roller</it.db.password>
        <it.db.container-alias>roller-it-postgres</it.db.container-alias>
        <it.postgres.image>postgres:16</it.postgres.image>

        <it.context.path>roller</it.context.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.codeborne</groupId>
            <artifactId>selenide</artifactId>
            <version>${selenide.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Browser-health checks read sub-resource status codes over the Chrome
             DevTools Protocol; Selenium 4's W3C API does not expose them. Selenium
             bundles the v150 bindings transitively, but pin them so a Selenium bump
             that drops v150 fails the build instead of failing at runtime. CDP
             bindings tolerate a couple of Chrome majors of drift. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-devtools-v150</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pulls the WAR into the reactor so cargo deploys the artifact this build
             produced, not a stale one from the local repository. -->
        <dependency>
            <groupId>org.apache.roller</groupId>
            <artifactId>roller-webapp</artifactId>
            <version>${project.version}</version>
            <type>war</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Reserve free ports so a developer's local PostgreSQL on 5432, or the
                 dev Jetty on 8083, cannot collide with a test run. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper.version}</version>
                <executions>
                    <execution>
                        <id>reserve-it-ports</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>reserve-network-port</goal>
                        </goals>
                        <configuration>
                            <portNames>
                                <portName>it.db.port</portName>
                                <portName>it.http.port</portName>
                                <portName>it.rmi.port</portName>
                                <portName>it.ajp.port</portName>
                            </portNames>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Delete the previous run's Tomcat configuration before deploying.
                 Cargo reuses target/cargo/configurations/, and Tomcat leaves an
                 exploded webapps/roller/ behind. Redeploying the WAR over a stale
                 explosion leaves a directory that shadows the new archive but is
                 missing jars, so the context fails to start with
                 ClassNotFoundException for Roller's own classes, and because it depends
                 on what the last run left behind, it fails intermittently.
                 Declared before cargo so it runs first within the phase. -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>${maven-clean.version}</version>
                <executions>
                    <execution>
                        <id>clean-cargo-configuration</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/cargo/configurations</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <version>${docker.plugin.version}</version>
                <configuration>
                    <images>
                        <image>
                            <alias>${it.db.container-alias}</alias>
                            <name>${it.postgres.image}</name>
                            <run>
                                <containerNamePattern>%a</containerNamePattern>
                                <ports>
                                    <port>${it.db.port}:5432</port>
                                </ports>
                                <env>
                                    <POSTGRES_USER>${it.db.user}</POSTGRES_USER>
                                    <POSTGRES_PASSWORD>${it.db.password}</POSTGRES_PASSWORD>
                                    <POSTGRES_DB>${it.db.name}</POSTGRES_DB>
                                </env>
                                <!-- The log line alone is not enough: the postgres image
                                     prints it once for its unix-socket-only init server
                                     before restarting to listen on TCP, so a log-only
                                     wait returns while the mapped port still refuses
                                     connections. Wait on the port as well. -->
                                <wait>
                                    <log>database system is ready to accept connections</log>
                                    <tcp>
                                        <mode>mapped</mode>
                                        <ports>
                                            <port>5432</port>
                                        </ports>
                                    </tcp>
                                    <time>60000</time>
                                </wait>
                            </run>
                        </image>
                    </images>
                </configuration>
                <executions>
                    <execution>
                        <id>pg-start</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>start</goal></goals>
                    </execution>
                    <execution>
                        <id>pg-stop</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>stop</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <!-- Belt and braces on top of the docker tcp wait: the port can be
                         open a moment before the server will answer queries, and
                         migrate.sh fails fast rather than retrying. Executions in the
                         same phase run in declaration order, so this must stay first. -->
                    <execution>
                        <id>pg-wait-ready</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>for i in $(seq 1 60); do pg_isready -h localhost -p ${it.db.port} -U ${it.db.user} -d ${it.db.name} -t 1 &amp;&amp; exit 0; sleep 1; done; echo "pg_isready timed out after 60s" &gt;&amp;2; exit 1</argument>
                            </arguments>
                            <environmentVariables>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Schema comes from the same migration chain production uses.
                         There is deliberately no test-specific DDL to drift. -->
                    <execution>
                        <id>pg-apply-migrations</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${project.basedir}/../bin/db/migrate.sh</executable>
                            <environmentVariables>
                                <DB_NAME>${it.db.name}</DB_NAME>
                                <DB_APP_USER>${it.db.user}</DB_APP_USER>
                                <PGHOST>localhost</PGHOST>
                                <PGPORT>${it.db.port}</PGPORT>
                                <PGUSER>${it.db.user}</PGUSER>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Seeds the admin user, weblog and category the sweep logs in
                         with. Must run before Tomcat starts: Roller caches
                         aggressively in-process. -->
                    <execution>
                        <id>pg-seed-it-data</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>psql</executable>
                            <arguments>
                                <argument>-v</argument><argument>ON_ERROR_STOP=1</argument>
                                <argument>-h</argument><argument>localhost</argument>
                                <argument>-p</argument><argument>${it.db.port}</argument>
                                <argument>-U</argument><argument>${it.db.user}</argument>
                                <argument>-d</argument><argument>${it.db.name}</argument>
                                <argument>-f</argument>
                                <argument>${project.basedir}/src/test/resources/seed-it-data.sql</argument>
                            </arguments>
                            <environmentVariables>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>${cargo.plugin.version}</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <artifactInstaller>
                            <groupId>org.apache.tomcat</groupId>
                            <artifactId>tomcat</artifactId>
                            <version>${it.tomcat.version}</version>
                        </artifactInstaller>
                        <log>${project.build.directory}/cargo.log</log>
                        <output>${project.build.directory}/tomcat.log</output>
                    </container>
                    <configuration>
                        <properties>
                            <cargo.servlet.port>${it.http.port}</cargo.servlet.port>
                            <cargo.rmi.port>${it.rmi.port}</cargo.rmi.port>
                            <cargo.tomcat.ajp.port>${it.ajp.port}</cargo.tomcat.ajp.port>
                            <cargo.jvmargs>-Djava.awt.headless=true</cargo.jvmargs>
                        </properties>
                        <!-- Roller looks up jdbc/rollerdb from JNDI; cargo writes the
                             Tomcat resource definition, so there is no hand-maintained
                             context.xml to keep in sync. -->
                        <datasources>
                            <datasource>
                                <jndiName>jdbc/rollerdb</jndiName>
                                <driverClass>org.postgresql.Driver</driverClass>
                                <url>jdbc:postgresql://localhost:${it.db.port}/${it.db.name}</url>
                                <username>${it.db.user}</username>
                                <password>${it.db.password}</password>
                            </datasource>
                        </datasources>
                    </configuration>
                    <deployables>
                        <deployable>
                            <groupId>org.apache.roller</groupId>
                            <artifactId>roller-webapp</artifactId>
                            <type>war</type>
                            <properties>
                                <context>${it.context.path}</context>
                            </properties>
                            <!-- Block until Roller itself answers, not merely until
                                 Tomcat's port opens. Without this the first tests can
                                 race the WAR deployment and get a context-not-found
                                 404, which surfaces as a pile of confusing assertion
                                 failures instead of one clear "the app never came up". -->
                            <pingURL>http://127.0.0.1:${it.http.port}/${it.context.path}/roller-ui/login.rol</pingURL>
                            <pingTimeout>180000</pingTimeout>
                        </deployable>
                    </deployables>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>cargo-start</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>start</goal></goals>
                    </execution>
                    <execution>
                        <id>cargo-stop</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>stop</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 127.0.0.1, not localhost: Tomcat binds IPv4 while Chrome resolves
                             localhost to ::1 first, so the browser gets connection-refused
                             against a server that is demonstrably listening. -->
                        <it.base.url>http://127.0.0.1:${it.http.port}/${it.context.path}</it.base.url>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
