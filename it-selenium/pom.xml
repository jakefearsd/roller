<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.roller</groupId>
        <artifactId>roller-project</artifactId>
        <version>0.1.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>roller-selenium-tests</artifactId>
    <name>Roller browser integration tests</name>
    <description>
        Selenide integration tests. The executable Roller WAR (Spring Boot 4,
        embedded Tomcat) is launched as a subprocess by start-app.sh against a
        dedicated PostgreSQL container whose schema is built by the real
        bin/db/migrations chain. Every test inherits browser-health checking, so a page
        that renders while its assets 404 fails rather than passing.

        Runs under `mvn verify -Pit`; excluded from the default build because it costs
        minutes rather than seconds.
    </description>

    <properties>
        <!-- Versions match the sibling jspwiki/wikantik Selenide suite. -->
        <selenide.version>7.17.0</selenide.version>
        <selenium.version>4.46.0</selenium.version>
        <!-- This module isn't a Spring Boot artifact and imports no BOM, so
             junit-jupiter needs an explicit pin (app/pom.xml gets its JUnit
             version for free from Spring Boot's dependencyManagement import;
             this module doesn't). Kept in step with app's resolved
             junit-jupiter version (JUnit 6). When bumping app/pom.xml's
             spring-boot.version, re-check what junit-jupiter version its BOM
             now resolves to and update this pin to match:
               mvn -ntp -pl app dependency:tree -Dincludes=org.junit.jupiter:junit-jupiter-api
             (currently resolves to 6.0.3, matching the pin below). -->
        <junit-jupiter.version>6.0.3</junit-jupiter.version>
        <docker.plugin.version>0.48.1</docker.plugin.version>
        <build-helper.version>3.6.0</build-helper.version>
        <exec.plugin.version>3.6.3</exec.plugin.version>
        <!-- app-stop only; see the plugin comment below for why it cannot share the
             exec-maven-plugin declaration used for app-start and the pg-* steps. -->
        <antrun.plugin.version>3.1.0</antrun.plugin.version>

        <it.db.name>roller_it</it.db.name>
        <it.db.user>roller</it.db.user>
        <it.db.password>roller</it.db.password>
        <it.db.container-alias>roller-it-postgres</it.db.container-alias>
        <it.postgres.image>postgres:16</it.postgres.image>

        <it.context.path>roller</it.context.path>

        <!-- start-app.sh/stop-app.sh bookkeeping. -->
        <it.app.war>${project.basedir}/../app/target/roller.war</it.app.war>
        <it.app.pidfile>${project.build.directory}/it-work/app.pid</it.app.pidfile>
        <it.app.log>${project.build.directory}/it-work/app.log</it.app.log>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.codeborne</groupId>
            <artifactId>selenide</artifactId>
            <version>${selenide.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Browser-health checks read sub-resource status codes over the Chrome
             DevTools Protocol; Selenium 4's W3C API does not expose them. Selenium
             bundles the v150 bindings transitively, but pin them so a Selenium bump
             that drops v150 fails the build instead of failing at runtime. CDP
             bindings tolerate a couple of Chrome majors of drift. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-devtools-v150</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Not consumed directly (start-app.sh reads app/target/roller.war off
             the filesystem, not via Maven artifact resolution): declared purely
             to force Maven reactor build order. Without a real inter-module
             dependency, `mvn verify -Pit` from the repo root has no guarantee
             app builds (and spring-boot:repackage rewrites roller.war into the
             executable jar-in-war start-app.sh needs) before this module's
             pre-integration-test phase runs. -->
        <dependency>
            <groupId>org.apache.roller</groupId>
            <artifactId>roller-webapp</artifactId>
            <version>${project.version}</version>
            <type>war</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- roller-it.properties (Roller's own -Droller.custom.config overlay, read by
             start-app.sh) needs ${it.db.port}, ${it.db.name}, ${project.basedir}, and
             ${project.build.directory} substituted; filtering is off by default for
             testResources, so it must be turned on explicitly here. seed-it-data.sql
             lives in the same directory and has no ${...} tokens of its own, so
             filtering the whole directory is harmless. -->
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>

        <plugins>

            <!-- Reserve free ports so a developer's local PostgreSQL on 5432, or the
                 dev server (./roller dev, spring-boot:run) on 8083, cannot collide
                 with a test run. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper.version}</version>
                <executions>
                    <execution>
                        <id>reserve-it-ports</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>reserve-network-port</goal>
                        </goals>
                        <configuration>
                            <portNames>
                                <portName>it.db.port</portName>
                                <portName>it.http.port</portName>
                            </portNames>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- app-stop, via maven-antrun-plugin rather than exec-maven-plugin
                 (which does the launching below): both this and docker-maven-plugin
                 bind an execution to post-integration-test, and Maven runs same-phase
                 executions in the order their owning <plugin> elements appear in this
                 file, so app-stop must be declared before docker-maven-plugin to win
                 that race; the app process (and its DB connections) must be gone
                 before pg-stop tears down the container it is talking to. exec-maven-
                 plugin cannot be reused for this: it already appears later in this file
                 (bound to pre-integration-test, where its executions must instead run
                 AFTER docker-maven-plugin's pg-start), and declaring the same plugin
                 GAV twice does not give two independently-positioned instances: Maven
                 merges duplicate <plugin> declarations into one, scheduled at the
                 position of the *first* occurrence, which would then run every
                 exec-maven-plugin execution (including the pre-integration-test ones
                 declared in the second block) before docker-maven-plugin's pg-start.
                 Confirmed via `mvn help:effective-pom`: the merge silently reorders
                 pg-wait-ready ahead of pg-start. A different plugin artifact avoids the
                 merge entirely. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${antrun.plugin.version}</version>
                <executions>
                    <execution>
                        <id>app-stop</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/src/test/script/stop-app.sh" failonerror="true">
                                    <arg value="${it.app.pidfile}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <version>${docker.plugin.version}</version>
                <configuration>
                    <images>
                        <image>
                            <alias>${it.db.container-alias}</alias>
                            <name>${it.postgres.image}</name>
                            <run>
                                <containerNamePattern>%a</containerNamePattern>
                                <ports>
                                    <port>${it.db.port}:5432</port>
                                </ports>
                                <env>
                                    <POSTGRES_USER>${it.db.user}</POSTGRES_USER>
                                    <POSTGRES_PASSWORD>${it.db.password}</POSTGRES_PASSWORD>
                                    <POSTGRES_DB>${it.db.name}</POSTGRES_DB>
                                </env>
                                <!-- The log line alone is not enough: the postgres image
                                     prints it once for its unix-socket-only init server
                                     before restarting to listen on TCP, so a log-only
                                     wait returns while the mapped port still refuses
                                     connections. Wait on the port as well. -->
                                <wait>
                                    <log>database system is ready to accept connections</log>
                                    <tcp>
                                        <mode>mapped</mode>
                                        <ports>
                                            <port>5432</port>
                                        </ports>
                                    </tcp>
                                    <time>60000</time>
                                </wait>
                            </run>
                        </image>
                    </images>
                </configuration>
                <executions>
                    <execution>
                        <id>pg-start</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>start</goal></goals>
                    </execution>
                    <execution>
                        <id>pg-stop</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>stop</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- pg-wait-ready / pg-apply-migrations / pg-seed-it-data / app-start: all
                 pre-integration-test, all must run after docker-maven-plugin's pg-start,
                 which is why this plugin is declared after it. See the app-stop
                 (maven-antrun-plugin) comment above for why app-stop is not simply a
                 fifth execution in this same block. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <!-- Belt and braces on top of the docker tcp wait: the port can be
                         open a moment before the server will answer queries, and
                         migrate.sh fails fast rather than retrying. Executions in the
                         same phase run in declaration order, so this must stay first. -->
                    <execution>
                        <id>pg-wait-ready</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>for i in $(seq 1 60); do pg_isready -h localhost -p ${it.db.port} -U ${it.db.user} -d ${it.db.name} -t 1 &amp;&amp; exit 0; sleep 1; done; echo "pg_isready timed out after 60s" &gt;&amp;2; exit 1</argument>
                            </arguments>
                            <environmentVariables>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Schema comes from the same migration chain production uses.
                         There is deliberately no test-specific DDL to drift. -->
                    <execution>
                        <id>pg-apply-migrations</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${project.basedir}/../bin/db/migrate.sh</executable>
                            <environmentVariables>
                                <DB_NAME>${it.db.name}</DB_NAME>
                                <DB_APP_USER>${it.db.user}</DB_APP_USER>
                                <PGHOST>localhost</PGHOST>
                                <PGPORT>${it.db.port}</PGPORT>
                                <PGUSER>${it.db.user}</PGUSER>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Seeds the admin user, weblog and category the sweep logs in
                         with. Must run before Tomcat starts: Roller caches
                         aggressively in-process. -->
                    <execution>
                        <id>pg-seed-it-data</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>psql</executable>
                            <arguments>
                                <argument>-v</argument><argument>ON_ERROR_STOP=1</argument>
                                <argument>-h</argument><argument>localhost</argument>
                                <argument>-p</argument><argument>${it.db.port}</argument>
                                <argument>-U</argument><argument>${it.db.user}</argument>
                                <argument>-d</argument><argument>${it.db.name}</argument>
                                <argument>-f</argument>
                                <argument>${project.basedir}/src/test/resources/seed-it-data.sql</argument>
                            </arguments>
                            <environmentVariables>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Launches the executable WAR (java -jar, embedded Tomcat) as a
                         background process and blocks until roller-ui/login.rol answers
                         or 180s elapse; the same readiness contract cargo's pingURL
                         enforced, now against a subprocess instead of a container-managed
                         Tomcat. Must run after pg-seed-it-data: Roller caches the seed
                         data aggressively in-process at startup, so seeding after the app
                         is already up would leave it looking at a stale view. See
                         start-app.sh for the WAR-not-found fast-fail message that points
                         at running the full reactor rather than this module alone. -->
                    <execution>
                        <id>app-start</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${project.basedir}/src/test/script/start-app.sh</executable>
                            <arguments>
                                <argument>${it.app.war}</argument>
                                <argument>${it.http.port}</argument>
                                <argument>${project.build.testOutputDirectory}/roller-it.properties</argument>
                                <argument>${it.app.pidfile}</argument>
                                <argument>${it.app.log}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 127.0.0.1, not localhost: Tomcat binds IPv4 while Chrome resolves
                             localhost to ::1 first, so the browser gets connection-refused
                             against a server that is demonstrably listening. -->
                        <it.base.url>http://127.0.0.1:${it.http.port}/${it.context.path}</it.base.url>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
