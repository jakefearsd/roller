# Roller production runtime configuration.
#
# Copy to deploy/config/roller-production.properties (gitignored -- it holds
# secrets) and fill in real values:
#   cp deploy/config/roller-production.properties.example \
#      deploy/config/roller-production.properties
#
# Mounted read-only into the app container at
# /config/roller-production.properties and loaded via
# -Droller.custom.config, which the image's ENTRYPOINT always passes (see
# Dockerfile and WebloggerConfig.java). Every key here overrides the built-in
# default from app/src/main/resources/org/apache/roller/weblogger/config/
# roller.properties, which documents the full set of overridable keys.

#-----------------------------------------------------------------------------
# Install / migrations
#-----------------------------------------------------------------------------
# 'auto': Roller checks the schema on startup and applies any migrations it
# doesn't find applied yet -- same as dev (app/src/test/resources/
# roller-boot-dev.properties). deploy.sh (Stage 1C Task 3) also runs
# bin/db/migrate.sh against postgres directly before restarting the app;
# both paths read the same V*.sql files and the same schema_migrations
# table, so running both is safe and order-independent (see migrate.sh).
installation.type=auto

#-----------------------------------------------------------------------------
# Database -- must match the postgres service's credentials in .env
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB)
#-----------------------------------------------------------------------------
database.configurationType=jdbc
database.jdbc.driverClass=org.postgresql.Driver
database.jdbc.connectionURL=jdbc:postgresql://postgres:5432/rollerdb
database.jdbc.username=roller
database.jdbc.password=changeme-generate-a-real-secret

#-----------------------------------------------------------------------------
# Directories -- per the runtime contract (Dockerfile + docker-compose.prod.yml):
# themes are baked into the image at build time, everything else lives on a
# named volume under /data mounted by docker-compose.prod.yml.
#-----------------------------------------------------------------------------
themes.dir=/app/themes
mediafiles.storage.dir=/data/mediafiles
search.index.dir=/data/search-index
uploads.dir=/data/uploads

#-----------------------------------------------------------------------------
# Mail -- operator-provided SMTP relay, used for comment notifications and
# password-reset mail. mail.username/mail.password are optional (only
# needed if your relay requires auth).
#-----------------------------------------------------------------------------
mail.configurationType=properties
mail.hostname=smtp.example.com
mail.port=587
#mail.username=
#mail.password=
