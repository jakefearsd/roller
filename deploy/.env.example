# Environment for docker-compose.prod.yml. Copy to .env in the repo root
# (`cp deploy/.env.example .env`) and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d`. Never commit the
# resulting .env -- it holds secrets (see .gitignore).

#-----------------------------------------------------------------------------
# Public domain / TLS
#-----------------------------------------------------------------------------
# Set your real domain here, e.g. blog.example.com -- Caddy (deploy/caddy/
# Caddyfile) requests and auto-renews a Let's Encrypt certificate for it and
# reverse-proxies HTTPS traffic to the app container. No further TLS config
# is needed; just DNS pointed at this host and ports 80/443 reachable from
# the internet (80 is used for the ACME HTTP-01 challenge).
#
# For LAN/local testing with no public domain and no DNS, use ":80" instead:
# Caddy then serves plain HTTP on port 80 only and never attempts ACME/TLS
# (auto-TLS activates only for a real hostname, never for a bare port).
ROLLER_DOMAIN=blog.example.com

#-----------------------------------------------------------------------------
# App image
#-----------------------------------------------------------------------------
# Published to ghcr.io/<owner>/roller by CI on every push to master (Stage 1C
# Task 4). Pin to a :<sha> tag for reproducible deploys, or track master with
# :latest. Ignored if you build locally instead
# (`docker compose -f docker-compose.prod.yml build app`).
ROLLER_IMAGE=ghcr.io/apache/roller:latest

# Extra JVM flags for the app container, e.g. -Xmx1g. Optional.
JAVA_OPTS=

#-----------------------------------------------------------------------------
# Postgres credentials
#-----------------------------------------------------------------------------
# Shared by the app, postgres, and backup services. database.jdbc.username/
# password in deploy/config/roller-production.properties must match
# POSTGRES_USER/POSTGRES_PASSWORD here -- the two files are not templated
# against each other, so keep them in sync by hand.
POSTGRES_DB=rollerdb
POSTGRES_USER=roller
POSTGRES_PASSWORD=changeme-generate-a-real-secret

#-----------------------------------------------------------------------------
# Nightly backup service (deploy/backup/)
#-----------------------------------------------------------------------------
# Hour (UTC, 0-23) the backup loop runs pg_dump + volume snapshots.
BACKUP_HOUR=3
# Days of backups to retain in the roller-backups volume before rotation.
BACKUP_RETENTION_DAYS=14
