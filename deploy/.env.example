# Environment for docker-compose.prod.yml. Copy to .env in the repo root
# (`cp deploy/.env.example .env`) and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d`. Never commit the
# resulting .env -- it holds secrets (see .gitignore).

#-----------------------------------------------------------------------------
# Public domain / TLS
#-----------------------------------------------------------------------------
# Set your real domain here, e.g. blog.example.com -- Caddy (deploy/caddy/
# Caddyfile) requests and auto-renews a Let's Encrypt certificate for it and
# reverse-proxies HTTPS traffic to the app container. No further TLS config
# is needed; just DNS pointed at this host and ports 80/443 reachable from
# the internet (80 is used for the ACME HTTP-01 challenge).
#
# For LAN/local testing with no public domain and no DNS, use ":80" instead:
# Caddy then serves plain HTTP on port 80 only and never attempts ACME/TLS
# (auto-TLS activates only for a real hostname, never for a bare port).
ROLLER_DOMAIN=blog.example.com

#-----------------------------------------------------------------------------
# App image
#-----------------------------------------------------------------------------
# Published to ghcr.io/<owner>/roller by CI on every push to master (Stage 1C
# Task 4). Pin to a :<sha> tag for reproducible deploys, or track master with
# :latest. Ignored if you build locally instead
# (`docker compose -f docker-compose.prod.yml build app`).
#
# NOTE: GHCR packages are private by default on their first publish. Until
# you either make the package public (GitHub -> Packages -> the package's
# own Settings -> Change visibility) or `docker login ghcr.io` on this host
# with a PAT that has `read:packages`, an anonymous pull of this image will
# fail with "denied" / "unauthorized". Use `deploy/deploy.sh --build`
# instead until one of those is done.
ROLLER_IMAGE=ghcr.io/jakefearsd/roller:latest

# Extra JVM flags for the app container, e.g. -Xmx1g. Optional.
JAVA_OPTS=

#-----------------------------------------------------------------------------
# Postgres credentials
#-----------------------------------------------------------------------------
# Shared by the app, postgres, and backup services. database.jdbc.username/
# password in deploy/config/roller-production.properties must match
# POSTGRES_USER/POSTGRES_PASSWORD here -- the two files are not templated
# against each other, so keep them in sync by hand.
POSTGRES_DB=rollerdb
POSTGRES_USER=roller
POSTGRES_PASSWORD=changeme-generate-a-real-secret

#-----------------------------------------------------------------------------
# Nightly backup service (deploy/backup/)
#-----------------------------------------------------------------------------
# Hour (UTC, 0-23) the backup loop runs pg_dump + volume snapshots. Use a
# bare number (e.g. `3`, `8`) -- both leading-zero (`08`) and bare (`8`)
# forms are accepted (deploy/backup/loop.sh forces base-10 parsing so a
# zero-padded hour is never misread as octal), but a bare number is clearer.
BACKUP_HOUR=3
# Days of backups to retain in the roller-backups volume before rotation.
BACKUP_RETENTION_DAYS=14

#-----------------------------------------------------------------------------
# Analytics (Umami)
#-----------------------------------------------------------------------------
# Self-hosted, cookie-free page analytics. No consent banner is required
# because nothing is stored on the reader's device.
#
# The tracker script and its collect endpoint are served from the BLOG's own
# origin at /analytics/* (deploy/caddy/Caddyfile). That is deliberate and not
# adjustable without work: every bundled theme sends a Content-Security-Policy
# with script-src 'self' and connect-src 'self', so a tracker on any other
# hostname is blocked by the reader's browser and silently records nothing.
#
# Signing key for Umami's own session tokens. Generate one and keep it:
# changing it logs everyone out of the dashboard.
#     openssl rand -hex 32
UMAMI_APP_SECRET=changeme-openssl-rand-hex-32

# Hostname for the Umami DASHBOARD, e.g. analytics.example.com, pointed at
# this host by DNS. Caddy obtains a certificate for it exactly as it does for
# ROLLER_DOMAIN. The dashboard cannot live under the blog's /analytics path:
# Umami's BASE_PATH is a build-time setting the prebuilt image does not carry,
# so its UI assumes it is at a domain root.
#
# Leave this unset and it defaults to analytics.invalid -- a name that cannot
# resolve, so the console is simply unreachable rather than accidentally
# published on your blog's domain.
#UMAMI_DOMAIN=analytics.example.com

# Database for analytics, created inside the existing postgres instance by
# deploy/deploy.sh and dumped nightly alongside the blog's own.
UMAMI_DB=umami

# Filename Umami serves its tracker under. Renaming it from the default
# script.js is the cheapest way to stop content blockers matching on the path;
# it must match the src in the snippet you paste into each weblog.
UMAMI_SCRIPT_NAME=script.js
