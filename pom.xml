<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apache.roller</groupId>
    <artifactId>roller-project</artifactId>
    <version>6.2.0</version>
    <packaging>pom</packaging>

    <name>Roller</name>
    <description>
        Roller is an open source multi-user blog server built with Spring MVC,
        Velocity, JPA/EclipseLink, and PostgreSQL.
    </description>
    <url>http://roller.apache.org</url>
    <inceptionYear>2002</inceptionYear>

    <scm>
        <url>https://github.com/apache/roller</url>
        <connection>scm:git:git://github.com/apache/roller.git</connection>
        <developerConnection>scm:git:git@github.com:apache/roller.git</developerConnection>
    </scm>

    <properties>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <roller.version>6.2.0</roller.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <maven-surefire.version>3.5.6</maven-surefire.version>

        <!-- JaCoCo coverage gate (jacoco:check on verify). The ratchet is ACTIVE:
             these floors are measured minus a 0.01 margin, and later stages only
             ever raise them, never lower them. Targets are documented in
             CLAUDE.md. -->
        <jacoco.line.minimum>0.8200</jacoco.line.minimum>
        <jacoco.branch.minimum>0.7270</jacoco.branch.minimum>
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

    <modules>
        <module>app</module>
    </modules>

    <profiles>
        <!-- Browser integration tests. Kept out of the default build because they
             deploy the WAR to a downloaded Tomcat against a PostgreSQL container and
             drive a real Chrome, costing minutes rather than seconds.

                 mvn verify -Pit

             Requires Docker and Google Chrome on the host. -->
        <profile>
            <id>it</id>
            <modules>
                <module>it-selenium</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                        <fork>true</fork>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <!-- Disable warnings from Struts TagAnnotationProcessor which doesn't support Java 11+ -->
                            <arg>-Xlint:-options</arg>
                            <arg>-Xlint:-processing</arg>
                        </compilerArgs>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-idea-plugin</artifactId>
                    <version>2.2.1</version>
                    <configuration>
                        <downloadSources>true</downloadSources>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.18.0</version>
                    <configuration>
                        <rulesUri>file:version-rules.xml</rulesUri>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Coverage floor, ratcheted from measured coverage. Later
                         stages only ever raise jacoco.line.minimum /
                         jacoco.branch.minimum / the PACKAGE rule below, never
                         lower them. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>org.apache.roller.weblogger.ui.rendering</include>
                                        <include>org.apache.roller.weblogger.ui.rendering.servlets</include>
                                        <include>org.apache.roller.weblogger.ui.rendering.velocity</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.48</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit is no longer pinned here: app/pom.xml imports Spring
                 Boot 4.1's BOM, which manages junit-jupiter 6.0.3 (JUnit 6)
                 and junit-platform-launcher together. See app/pom.xml's
                 dependencyManagement comment for why the previous re-import
                 pattern existed and why it is gone. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
