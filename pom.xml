<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apache.roller</groupId>
    <artifactId>roller-project</artifactId>
    <version>0.1.3</version>
    <packaging>pom</packaging>

    <name>Roller</name>
    <description>
        Roller is an open source multi-user blog server built with Spring MVC,
        Velocity, JPA/EclipseLink, and PostgreSQL.
    </description>
    <url>https://github.com/jakefearsd/roller</url>
    <inceptionYear>2002</inceptionYear>

    <scm>
        <url>https://github.com/jakefearsd/roller</url>
        <connection>scm:git:git://github.com/jakefearsd/roller.git</connection>
        <developerConnection>scm:git:git@github.com:jakefearsd/roller.git</developerConnection>
    </scm>

    <properties>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <testcontainers.version>2.0.5</testcontainers.version>
        <maven-surefire.version>3.5.6</maven-surefire.version>

        <!-- JaCoCo coverage gate (jacoco:check on verify). The ratchet is ACTIVE:
             these floors are measured minus a 0.01 margin, and later stages only
             ever raise them, never lower them. Targets are documented in
             CLAUDE.md.

             Measured after W2 (the minimalism program's second subtraction
             wave): LINE 0.8705, BRANCH 0.7958.

             BRANCH moves 0.7800 to 0.7900. LINE deliberately does NOT move, and
             the reason is worth keeping: at 0.8705 measured against a 0.8700
             floor it is already binding to within five hundredths of a point,
             so it behaves as a ratchet with no slack, and one uncovered line
             anywhere fails the build whatever the change was about. That is
             the same failure mode the PACKAGE comment below records for the
             velocity package at 0.4900, and raising LINE here would make it
             worse rather than better. Coverage of NEW work is held by
             bin/check-diff-coverage.sh (~90% of changed lines), not by this
             floor; this floor's job is to stop the whole-codebase number
             sliding, and it does that already. Raise it only after a wave that
             genuinely adds line coverage in bulk. -->
        <jacoco.line.minimum>0.8700</jacoco.line.minimum>
        <jacoco.branch.minimum>0.7900</jacoco.branch.minimum>
        <jacoco.check.skip>false</jacoco.check.skip>

        <!-- TEMPORARY, deleted in the final task of the static-analysis wave.
             The tree starts at 362 PMD / 134 SpotBugs violations against
             this exact ruleset/filter, measured directly from this task's
             own `mvn -pl app compile pmd:pmd spotbugs:spotbugs` run (the
             wave's design doc estimated 307 / 132; the live count on this
             tree is what actually gates the build, and is higher: see the
             task's own report for the reconciliation). Rather than leave the
             build red for a dozen commits, the gate goes in at today's
             count: green now, and any NEW violation fails immediately. Each
             fix batch lowers these. When both reach 0 the properties go away
             and the gate is absolute. This is a scaffold, not the ratcheted
             ceiling the spec rejected: the difference is that it has a
             scheduled end. -->
        <pmd.max.violations>64</pmd.max.violations>
        <spotbugs.max.violations>64</spotbugs.max.violations>
        <quality.check.skip>false</quality.check.skip>
    </properties>

    <modules>
        <module>app</module>
    </modules>

    <profiles>
        <!-- Browser integration tests. Kept out of the default build because they
             deploy the WAR to a downloaded Tomcat against a PostgreSQL container and
             drive a real Chrome, costing minutes rather than seconds.

                 mvn verify -Pit

             Requires Docker and Google Chrome on the host. -->
        <profile>
            <id>it</id>
            <modules>
                <module>it-selenium</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <!-- Java 25. Also asserted by maven-enforcer below (which
                             checks the JVM actually running the build, not just
                             the bytecode target), by the CI matrix in
                             .github/workflows/main.yml, and by the digest-pinned
                             temurin-25 images in Dockerfile. Moving the language
                             level means moving all four. -->
                        <release>25</release>
                        <fork>true</fork>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <!-- -options silences the bootclasspath/release advisory;
                                 -processing silences "no processor claimed this token"
                                 for the annotations only frameworks read at runtime.
                                 (This pair predates the Spring MVC migration and was
                                 attributed to Struts' TagAnnotationProcessor, which
                                 has not been a dependency since.) -->
                            <arg>-Xlint:-options</arg>
                            <arg>-Xlint:-processing</arg>
                        </compilerArgs>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-idea-plugin</artifactId>
                    <version>2.2.1</version>
                    <configuration>
                        <downloadSources>true</downloadSources>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.18.0</version>
                    <configuration>
                        <rulesUri>file:version-rules.xml</rulesUri>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/config/pmd/ruleset.xml</ruleset>
                        </rulesets>
                        <targetJdk>25</targetJdk>
                        <includeTests>false</includeTests>
                        <printFailingErrors>true</printFailingErrors>
                        <failOnViolation>true</failOnViolation>
                        <skip>${quality.check.skip}</skip>
                        <!-- CPD: 200 tokens. Below that the gate starts demanding refactors
                             whose risk exceeds the duplication's cost: at 100 it flags the
                             three render caches, whose expiry contracts genuinely differ. -->
                        <minimumTokens>200</minimumTokens>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>7.26.0</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>7.26.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.9.8.5</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <includeTests>false</includeTests>
                        <failOnError>true</failOnError>
                        <skip>${quality.check.skip}</skip>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Pins the JDK the build actually RUNS on. maven-compiler-plugin's
                 <release>25</release> only fixes the language level and bytecode
                 target: a JDK 26 or 30 toolchain compiles release-25 sources
                 happily and then runs the whole test suite on a JVM nobody
                 verified, which is how a green local build ships behaviour CI
                 never saw. [25,26) fails that at validate, with a message, rather
                 than at some puzzling runtime difference later. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-jdk-25</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Roller builds on JDK 25 only. See maven-compiler-plugin's &lt;release&gt;25&lt;/release&gt; above, the CI matrix in .github/workflows/main.yml, and the temurin-25 images in Dockerfile.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Coverage floor, ratcheted from measured coverage. Later
                         stages only ever raise jacoco.line.minimum /
                         jacoco.branch.minimum / the PACKAGE rule below, never
                         lower them. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>org.apache.roller.weblogger.ui.rendering</include>
                                        <include>org.apache.roller.weblogger.ui.rendering.servlets</include>
                                        <include>org.apache.roller.weblogger.ui.rendering.velocity</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Raised from 0.48 once the velocity package gained
                                                 its first direct tests. It had sat at exactly
                                                 0.4900 against this floor, so any macro change
                                                 that added an untested branch broke the build for
                                                 reasons unrelated to the change.

                                                 0.55 to 0.60 after W2. The binding package is
                                                 still velocity, now at 0.6190 (servlets 0.6667,
                                                 rendering 0.8020); the subtraction waves removed
                                                 the RSS and comment feed paths, which were among
                                                 the least covered here. Unlike the BUNDLE LINE
                                                 floor above, this one has real slack to take. -->
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit is no longer pinned here: app/pom.xml imports Spring
                 Boot 4.1's BOM, which manages junit-jupiter 6.0.3 (JUnit 6)
                 and junit-platform-launcher together. See app/pom.xml's
                 dependencyManagement comment for why the previous re-import
                 pattern existed and why it is gone. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
