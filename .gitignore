# Taken from http://gary-rowe.com/agilestack/2012/10/12/a-gitignore-file-for-intellij-and-eclipse-with-maven/
#
# Eclipse
.classpath
.project
.settings/

# Intellij
.idea/
*.iml
*.iws

# NetBeans
nb-configuration.xml
nbproject

# Mac
.DS_Store

# Maven
log/
target/

velocity.log

tomcat-base
docker/postgresql-data
docker/roller-data
it-selenium/overlays/
*.log
*.log.gz
logs/
app/logs/
socket:*

# Selenide writes failure screenshots and page dumps here (Configuration.reportsFolder
# defaults to build/reports/tests, not target/).
it-selenium/build/
.claude/worktrees/

# Production deployment secrets -- operator-created from the .example
# templates in deploy/, never committed (see docker-compose.prod.yml).
/.env
deploy/.env.test
deploy/config/roller-production.properties

.superpowers/
